{
  "name": "nabome",
  "version": "0.1.0",
  "private": true,
  "description": "নবME (Nabome) Commerce Operating System — monorepo",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver",
      "@prisma/client",
      "prisma"
    ]
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter @nabome/api dev",
    "dev:customer": "pnpm --filter @nabome/customer dev",
    "dev:admin": "pnpm --filter @nabome/admin dev",
    "dev:shop": "pnpm --filter @nabome/shop dev",
    "build": "pnpm -r build",
    "build:api": "pnpm --filter @nabome/api build",
    "build:customer": "pnpm --filter @nabome/customer build",
    "build:admin": "pnpm --filter @nabome/admin build",
    "build:shop": "pnpm --filter @nabome/shop build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r test:unit",
    "test:integration": "pnpm -r test:integration",
    "test:e2e": "pnpm --filter @nabome/e2e test:e2e",
    "bootstrap": "node scripts/bootstrap.mjs",
    "clean": "node scripts/clean.mjs",
    "clean:all": "node scripts/clean.mjs --all",
    "validate": "node scripts/check-architecture.mjs && node scripts/validate-env.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test:unit && pnpm validate",
    "check:deploy": "node infra/scripts/check-deploy.mjs",
    "check:deploy:staging": "node infra/scripts/check-deploy.mjs staging",
    "check:deploy:production": "node infra/scripts/check-deploy.mjs production",
    "db:generate": "pnpm --filter @nabome/api db:generate",
    "db:migrate": "pnpm --filter @nabome/api db:migrate",
    "db:seed": "pnpm --filter @nabome/api db:seed",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^9.17.0",
    "@nabome/api-contracts": "workspace:*",
    "@nabome/auth": "workspace:*",
    "@nabome/config": "workspace:*",
    "@nabome/constants": "workspace:*",
    "@nabome/design-tokens": "workspace:*",
    "@nabome/logging": "workspace:*",
    "@nabome/types": "workspace:*",
    "@nabome/ui": "workspace:*",
    "@nabome/utils": "workspace:*",
    "@nabome/validation": "workspace:*",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import-x": "^4.5.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.19.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yaml,yml,html}": [
      "prettier --write"
    ]
  }
}
