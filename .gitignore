# ──────────────────────────────────────────────────────────────────────────────
# নবME (Nabome) — Git Ignore
# ──────────────────────────────────────────────────────────────────────────────

# Dependencies
node_modules/

# Build artifacts
dist/
dist-ssr/
.turbo/
*.tsbuildinfo
.tsbuild/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment & secrets
.env
.env.*
!.env.example
!**/.env.example
!apps/api/.dev.vars.example
!.dev.vars.example
.dev.vars
*.pem
*.key
*.p12
*.pfx

# Test artifacts
coverage/
playwright-report/
test-results/
.nyc_output/

# Wrangler / Cloudflare local state
.wrangler/
_worker.bundle
apps/api/worker-configuration.d.ts

# Prisma
apps/api/prisma/generated/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
.DS_Store
Thumbs.db

# Audit screenshots
.audit-*.png

# One-time scripts
*.sh

# Misc
.plan/
.vercel/
