// ── Base tables ──────────────────────────────────────────────────────────────

model User {
  // V1: JWT + bcrypt authentication
  // Password hash stored locally for self-contained auth
  id               String     @id @default(uuid()) @db.Uuid
  email            String     @unique @db.VarChar(320)
  phone            String?    @unique @db.VarChar(20)
  firstName        String?    @db.VarChar(120)
  lastName         String?    @db.VarChar(120)
  passwordHash     String?    @db.Text
  role             UserRole   @default(customer)
  status           UserStatus @default(pending_verification)
  emailVerifiedAt  DateTime?  @db.Timestamptz(6)
  locale           String     @default("en-IN") @db.VarChar(10)
  avatarUrl        String?    @db.Text
  isActive         Boolean    @default(true)
  lastLoginAt      DateTime?  @db.Timestamptz(6)
  createdAt        DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime   @updatedAt @db.Timestamptz(6)

  addresses        Address[]
  orders           Order[]
  shops            Shop[]
  wishlists        Wishlist[]
  reviews          Review[]
  sessions         Session[]
  notifications    Notification[]
  loginHistory     LoginHistory[]
  passwordResets   PasswordReset[]
  emailVerifications EmailVerification[]
  savedPaymentMethods SavedPaymentMethod[]
  customerPreference CustomerPreference?
  notificationPreference NotificationPreference?
  recentlyViewed   RecentlyViewed[]
  shopMemberships ShopMember[]

  @@index([status])
  @@index([role])
  @@index([email])
  @@map("users")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  refreshToken String   @unique @db.Text
  csrfToken    String   @db.Text
  userAgent    String?  @db.Text
  ipAddress    String?  @db.VarChar(45)
  expiresAt    DateTime @db.Timestamptz(6)
  revokedAt    DateTime? @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([refreshToken])
  @@map("sessions")
}

model LoginHistory {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  ipAddress     String?  @db.VarChar(45)
  userAgent     String?  @db.Text
  success       Boolean  @default(true)
  failureReason String?  @db.Text
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([success])
  @@map("login_history")
}

model PasswordReset {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime @db.Timestamptz(6)
  used      Boolean  @default(false)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("password_resets")
}

model EmailVerification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime @db.Timestamptz(6)
  used      Boolean  @default(false)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("email_verifications")
}

model Address {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  type      AddressType @default(home)
  label     String?     @db.VarChar(60)
  line1     String      @db.VarChar(255)
  line2     String?     @db.VarChar(255)
  city      String      @db.VarChar(120)
  state     String      @db.VarChar(120)
  postalCode String     @db.VarChar(12)
  country   String      @default("IN") @db.VarChar(2)
  phone     String      @db.VarChar(20)
  isDefault Boolean     @default(false)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt DateTime    @updatedAt @db.Timestamptz(6)

  user      User        @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("addresses")
}

// ── Catalog (binding: B.3) ───────────────────────────────────────────────────

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @db.VarChar(120)
  slug        String    @unique @db.VarChar(160)
  description String?   @db.Text
  parentId    String?   @db.Uuid
  iconUrl     String?   @db.Text
  banner      String?   @db.Text
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  isHidden    Boolean   @default(false)
  metaTitle       String? @db.VarChar(300)
  metaDescription String? @db.VarChar(500)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)

  parent      Category? @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[] @relation("ProductCategory")
  commissionRates CommissionRate[]

  @@index([parentId])
  @@index([isActive])
  @@index([isHidden])
  @@index([parentId, sortOrder])
  @@index([isActive, parentId])
  @@map("categories")
}

model Brand {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(120)
  slug      String   @unique @db.VarChar(160)
  logoUrl   String?  @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  products  Product[]

  @@map("brands")
}

model Collection {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @db.VarChar(120)
  slug        String    @unique @db.VarChar(160)
  description String?   @db.Text
  imageUrl    String?   @db.Text
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  isFeatured  Boolean   @default(false)
  type        CollectionType @default(manual)
  startsAt    DateTime? @db.Timestamptz(6)
  endsAt      DateTime? @db.Timestamptz(6)
  metaTitle       String? @db.VarChar(300)
  metaDescription String? @db.VarChar(500)
  rules       Json?
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)

  products    ProductCollection[]

  @@index([isActive])
  @@index([isFeatured])
  @@index([type])
  @@index([startsAt, endsAt])
  @@index([isActive, isFeatured])
  @@map("collections")
}

model Product {
  id              String          @id @default(uuid()) @db.Uuid
  categoryId      String          @db.Uuid
  brandId         String?         @db.Uuid
  shopId          String          @db.Uuid
  name            String          @db.VarChar(255)
  slug            String          @unique @db.VarChar(190)
  shortDescription String?        @db.Text
  description     String?         @db.Text
  status          ProductStatus   @default(draft)
  isFeatured      Boolean         @default(false)
  isNew           Boolean         @default(false)
  isTrending      Boolean         @default(false)
  gender          Gender          @default(unisex)
  sortOrder       Int             @default(0)
  basePrice       Decimal         @db.Decimal(10, 2)
  compareAtPrice  Decimal?        @db.Decimal(10, 2)
  costPrice       Decimal?        @db.Decimal(10, 2)
  weightGrams     Int?            @db.Integer
  isActive        Boolean         @default(true)
  metaTitle       String?         @db.VarChar(300)
  metaDescription String?         @db.VarChar(500)
  ogImage         String?         @db.Text
  reviewCount     Int             @default(0)
  averageRating   Decimal         @db.Decimal(3, 2) @default(0)
  totalSold       Int             @default(0)
  tags            String[]
  meta            Json?
  createdAt       DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(6)

  category        Category        @relation("ProductCategory", fields: [categoryId], references: [id])
  brand           Brand?          @relation(fields: [brandId], references: [id])
  shop            Shop            @relation(fields: [shopId], references: [id])
  collections     ProductCollection[]
  variants        ProductVariant[]
  media           ProductMedia[]
  attributes      ProductAttribute[]
  reviews         Review[]
  wishlistItems   WishlistItem[]
  orderItems      OrderItem[]
  cartItems       CartItem[]

  @@index([categoryId])
  @@index([brandId])
  @@index([shopId])
  @@index([status])
  @@index([status, isFeatured])
  @@index([status, isNew])
  @@index([status, isTrending])
  @@index([status, gender, createdAt])
  @@index([status, categoryId, sortOrder])
  @@index([status, basePrice])
  @@index([createdAt])
  @@index([sortOrder])
  @@map("products")
}

model ProductVariant {
  id              String          @id @default(uuid()) @db.Uuid
  productId       String          @db.Uuid
  sku             String          @unique @db.VarChar(120)
  name            String          @db.VarChar(255)
  attributes      Json?           @db.Json
  price           Decimal         @db.Decimal(10, 2)
  compareAtPrice  Decimal?        @db.Decimal(10, 2)
  availableStock  Int             @default(0) @db.Integer
  reservedStock   Int             @default(0) @db.Integer
  inventoryStatus InventoryStatus @default(out_of_stock)
  lowStockThreshold Int           @default(10) @db.Integer
  isActive        Boolean         @default(true)
  sortOrder       Int             @default(0)
  version         Int             @default(0) @db.Integer
  createdAt       DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(6)

  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  media           ProductMedia[]
  wishlistItems   WishlistItem[]
  orderItems      OrderItem[]
  stockMovements  StockMovement[]
  stockReservations StockReservation[]
  cartItems       CartItem[]

  @@index([productId, isActive])
  @@index([isActive, availableStock])
  @@index([inventoryStatus])
  @@map("product_variants")
}

model ProductMedia {
  id        String          @id @default(uuid()) @db.Uuid
  productId String          @db.Uuid
  variantId String?         @db.Uuid
  type      String          @default("image") @db.VarChar(20)
  url       String          @db.Text
  altText   String?         @db.VarChar(255)
  sortOrder Int             @default(0) @db.Integer
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now()) @db.Timestamptz(6)

  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([productId])
  @@map("product_media")
}

model ProductAttribute {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @db.Uuid
  name      String  @db.VarChar(120)
  value     String  @db.VarChar(255)

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_attributes")
}

model ProductCollection {
  productId    String     @db.Uuid
  collectionId String     @db.Uuid
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)

  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@map("product_collections")
}

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  userId    String   @db.Uuid
  rating    Int      @db.Integer
  title     String?  @db.VarChar(255)
  body      String?  @db.Text
  isApproved Boolean @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([userId])
  @@map("reviews")
}

// ── Cart & wishlist ──────────────────────────────────────────────────────────

model CartItem {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String?  @db.Uuid
  guestId         String?  @db.VarChar(64)
  productId       String   @db.Uuid
  variantId       String   @db.Uuid
  quantity        Int      @default(1) @db.Integer
  unitPrice       Decimal  @db.Decimal(10, 2)
  lineTotal       Decimal  @db.Decimal(10, 2)
  priceSnapshot   Json?    @db.Json
  variantSnapshot Json?    @db.Json
  reservedStock   Int      @default(0) @db.Integer
  reservationId   String?  @db.Uuid
  isActive        Boolean  @default(true)
  addedAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  product         Product        @relation(fields: [productId], references: [id])
  variant         ProductVariant @relation(fields: [variantId], references: [id])

  @@index([userId])
  @@index([guestId])
  @@index([productId])
  @@index([variantId])
  @@index([reservationId])
  @@index([isActive])
  @@unique([userId, variantId])
  @@map("cart_items")
}

model Wishlist {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  name        String   @default("Default") @db.VarChar(100)
  description String?  @db.Text
  isDefault   Boolean  @default(true)
  isShared    Boolean  @default(false)
  shareToken  String?  @unique @db.VarChar(64)
  shareExpiresAt DateTime? @db.Timestamptz(6)
  itemCount   Int      @default(0) @db.Integer
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
