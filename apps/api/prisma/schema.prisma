// Payment lifecycle (binding: Blueprint B.3, PAYMENT §4.4, ML-02):
// created → initiated → processing → authorized → captured → completed,
// with failed (→ created retry), cancelled, expired (→ created retry), and
// refund transitions captured/completed → partially_refunded → refunded.
// Legacy values (pending/processing/succeeded) remain valid for existing rows.
enum PaymentStatus {
  pending
  processing
  succeeded
  created
  initiated
  authorized
  captured
  completed
  failed
  cancelled
  expired
  partially_refunded
  refunded
  refunding
}

// Order payment sub-status (binding: CC-28 — pending|authorized|captured|refunding|refunded|failed).
// Legacy awaiting_* values remain valid for existing rows.
enum OrderPaymentSubStatus {
  pending
  authorized
  captured
  refunding
  refunded
  failed
  awaiting_bank_confirmation
  awaiting_upi_confirmation
  awaiting_authorization
  awaiting_capture
}

// Refund operational lifecycle (binding: PAYMENT §7.9, ML-03):
// initiated → processing → completed → settled, failed (retry).
// Legacy value succeeded maps from completed/settled.
enum RefundStatus {
  pending
  processing
  succeeded
  failed
  initiated
  completed
  settled
}

enum RefundType {
  full
  partial
}

// Settlement lifecycle (binding: Blueprint B.4, FINANCE §4.5, ML-09/12):
// PENDING → ELIGIBLE → CREATED → REVIEW → APPROVED → PROCESSING → COMPLETED → PAID,
// plus REJECTED → PENDING, FAILED (from PROCESSING), REVERSED (from COMPLETED or PAID).
// Legacy values (settled/on_hold/initiated/retry_pending/partially_settled/manual_review/cancelled)
// remain valid for existing rows.
enum SettlementStatus {
  pending
  eligible
  created
  review
  approved
  processing
  completed
  paid
  rejected
  failed
  reversed
  settled
  on_hold
  cancelled
  initiated
  retry_pending
  partially_settled
  manual_review
}

