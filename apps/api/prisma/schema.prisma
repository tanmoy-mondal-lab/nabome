// ---------------------------------------------------------------------------
// নবME (Nabome) Commerce OS — canonical Prisma schema
// Source of truth: MASTER_ARCHITECTURE_BLUEPRINT.md Appendix B (data model).
// Conventions: snake_case names, UUIDv4 ids, Decimal(10,2) money, enums as
// listed in B.4–B.7, soft delete via isActive, timestamps via @@map.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums (binding: B.4) ─────────────────────────────────────────────────────

