model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  orderId       String        @db.Uuid
  method        PaymentMethod
  status        PaymentStatus @default(pending)
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("INR") @db.VarChar(3)
  // Gateway provider adapter (binding: PAYMENT §3 — no gateway logic in business modules).
  provider      String?       @db.VarChar(40)
  // Gateway transaction reference (provider-neutral; razorpay* fields are legacy).
  gatewayReference String?    @db.VarChar(120)
  razorpayOrderId String?      @db.VarChar(64)
  razorpayPaymentId String?    @db.VarChar(64)
  razorpaySignature String?    @db.VarChar(255)
  failureReason  String?       @db.Text
  // Payment window (binding: PAYMENT §4.8 — 15 minutes) and idempotency (DB §7.3).
  expiresAt      DateTime?     @db.Timestamptz(6)
  idempotencyKey String?       @db.VarChar(120)
  metadata       Json?         @db.Json
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(6)

  order         Order          @relation(fields: [orderId], references: [id])
  refunds       Refund[]
  transactions  PaymentTransaction[]

  @@unique([idempotencyKey])
  @@index([orderId])
  @@index([status])
  @@index([provider])
  @@map("payments")
}

