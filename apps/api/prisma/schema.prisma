model Order {
  id                     String                  @id @default(uuid()) @db.Uuid
  orderNumber            String                  @unique @db.VarChar(30)
  userId                 String                  @db.Uuid
  shopId                 String?                 @db.Uuid
  status                 OrderStatus             @default(pending)
  customerVisibleStatus  CustomerVisibleOrderStatus @default(pending)
  paymentStatus          PaymentStatus           @default(pending)
  paymentSubStatus       OrderPaymentSubStatus?
  refundStatus           RefundStatus?
  shipmentStatus         ShipmentStatus?
  settlementStatus       SettlementStatus?
  itemsSubtotal          Decimal                 @db.Decimal(10, 2)
  shippingTotal          Decimal                 @default(0) @db.Decimal(10, 2)
  discountTotal          Decimal                 @default(0) @db.Decimal(10, 2)
  taxTotal               Decimal                 @default(0) @db.Decimal(10, 2)
  grandTotal             Decimal                 @db.Decimal(10, 2)
  currency               String                  @default("INR") @db.VarChar(3)
  billingAddressId       String?                 @db.Uuid
  shippingAddressId      String?                 @db.Uuid
  billingSnapshot        Json?                   @db.Json
  shippingSnapshot       Json?                   @db.Json
  paymentMethod          PaymentMethod?
  razorpayOrderId        String?                 @db.VarChar(64)
  razorpayPaymentId      String?                 @db.VarChar(64)
  couponCode             String?                 @db.VarChar(60)
  notes                  String?                 @db.Text
  placedAt               DateTime                @default(now()) @db.Timestamptz(6)
  isActive               Boolean                 @default(true)
  createdAt              DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                @updatedAt @db.Timestamptz(6)
  // Commission snapshot at order time for financial integrity
  commissionRate         Decimal?                @db.Decimal(5, 2)
  commissionAmount       Decimal?                @db.Decimal(10, 2)
  commissionSnapshot     Json?                   @db.Json

  user                   User                    @relation(fields: [userId], references: [id])
  shop                   Shop?                   @relation(fields: [shopId], references: [id])
  items                  OrderItem[]
  shipments              Shipment[]
  payments               Payment[]
  refunds                Refund[]
  returnRequests         ReturnRequest[]
  timelineEvents         TimelineEvent[]
  financeRecords         FinanceRecord[]
  settlementItems        SettlementItem[]
  codOrder               CodOrder?

  @@index([userId])
  @@index([shopId])
  @@index([status])
  @@index([paymentStatus])
  @@index([placedAt])
  @@map("orders")
}

model OrderItem {
  id            String         @id @default(uuid()) @db.Uuid
  orderId       String         @db.Uuid
  productId     String         @db.Uuid
  variantId     String         @db.Uuid
