  attachments   String[] @default([])
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  dispute       Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@index([disputeId])
  @@index([createdAt])
  @@map("dispute_messages")
}

model ReturnPolicy {
  id                         String            @id @default(uuid()) @db.Uuid
  shopId                     String            @db.Uuid
  policyType                 ReturnPolicyType
  name                       String            @db.VarChar(255)
  description                String?           @db.Text
  returnWindowDays           Int               @db.Integer
  eligibleProductCategories String[]          @default([])
  ineligibleProductCategories String[]         @default([])
  requiresApproval           Boolean           @default(false)
  requiresOriginalPackaging  Boolean           @default(true)
  requiresProofOfPurchase    Boolean           @default(true)
  customerPaysReturnShipping Boolean           @default(false)
  restockingFeePercentage    Decimal?          @db.Decimal(5, 2)
  maxReturnsPerOrder         Int?              @db.Integer
  maxReturnsPerCustomer      Int?              @db.Integer
  maxReturnsPerPeriod        Int?              @db.Integer
  returnPeriodDays           Int?              @db.Integer
  conditions                 String[]          @default([])
  isActive                   Boolean           @default(true)
  effectiveFrom              DateTime          @default(now()) @db.Timestamptz(6)
  effectiveUntil             DateTime?         @db.Timestamptz(6)
  metadata                   Json?
  createdAt                  DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime          @updatedAt @db.Timestamptz(6)

  @@index([shopId])
  @@index([isActive])
  @@index([effectiveFrom, effectiveUntil])
  @@map("return_policies")
}

model TimelineEvent {
  id               String               @id @default(uuid()) @db.Uuid
  orderId          String               @db.Uuid
  type             TimelineEventType
  description       String               @db.Text
  priority         TimelineEventPriority @default(normal)
  customerVisible  Boolean              @default(true)
  metadata         Json?
  performedBy      String?              @db.Uuid
  performedByType  String?              @db.VarChar(50)
  occurredAt       DateTime             @default(now()) @db.Timestamptz(6)
  isActive         Boolean              @default(true)
  createdAt        DateTime             @default(now()) @db.Timestamptz(6)

  order            Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([type])
  @@index([occurredAt])
  @@index([customerVisible])
  @@index([orderId, occurredAt])
  @@map("timeline_events")
}

// ── Inventory & Warehouse Management ───────────────────────────────────────────

model Warehouse {
  id          String          @id @default(uuid()) @db.Uuid
  name        String          @db.VarChar(255)
  code        String          @unique @db.VarChar(50)
  address     String          @db.Text
  city        String          @db.VarChar(120)
  state       String          @db.VarChar(120)
  postalCode  String          @db.VarChar(12)
  country     String          @default("IN") @db.VarChar(2)
  phone       String?         @db.VarChar(20)
  email       String?         @db.VarChar(255)
  status      WarehouseStatus @default(active)
  priority    Int             @default(0) @db.Integer
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(6)

  stockMovements StockMovement[]
  stockReservations StockReservation[]

  @@index([status])
  @@index([priority])
  @@map("warehouses")
}

model StockMovement {
  id              String           @id @default(uuid()) @db.Uuid
  variantId       String           @db.Uuid
  warehouseId     String?          @db.Uuid
  type            StockMovementType
  quantity        Int              @db.Integer
  previousStock   Int              @db.Integer
  newStock        Int              @db.Integer
  reason          String?          @db.Text
  referenceId     String?          @db.VarChar(255)
  referenceType   String?          @db.VarChar(50)
  performedBy     String?          @db.Uuid
  performedByType String?          @db.VarChar(50)
  metadata        Json?
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)

  variant         ProductVariant   @relation(fields: [variantId], references: [id])
  warehouse       Warehouse?      @relation(fields: [warehouseId], references: [id])

  @@index([variantId])
  @@index([warehouseId])
  @@index([type])
  @@index([createdAt])
  @@index([variantId, createdAt])
  @@map("stock_movements")
}

model StockReservation {
  id              String            @id @default(uuid()) @db.Uuid
  variantId       String            @db.Uuid
  warehouseId     String?           @db.Uuid
  orderId         String?           @db.Uuid
  cartId          String?           @db.VarChar(64)
  quantity        Int               @db.Integer
  status          ReservationStatus @default(active)
  expiresAt       DateTime          @db.Timestamptz(6)
  releasedAt      DateTime?         @db.Timestamptz(6)
  convertedAt     DateTime?         @db.Timestamptz(6)
  metadata        Json?
  createdAt       DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(6)

  variant         ProductVariant   @relation(fields: [variantId], references: [id])
  warehouse       Warehouse?       @relation(fields: [warehouseId], references: [id])

  @@index([variantId, status])
  @@index([warehouseId, status])
  @@index([orderId])
  @@index([cartId])
  @@index([expiresAt])
  @@index([status, expiresAt])
  @@index([expiresAt, status])
  @@map("stock_reservations")
}

model LowStockAlert {
  id              String   @id @default(uuid()) @db.Uuid
  variantId       String   @db.Uuid
  currentStock    Int      @db.Integer
  threshold       Int      @db.Integer
  isAcknowledged Boolean  @default(false)
  acknowledgedBy String?  @db.Uuid
  acknowledgedAt DateTime? @db.Timestamptz(6)
  metadata        Json?
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  @@index([variantId])
  @@index([isAcknowledged])
  @@index([createdAt])
  @@map("low_stock_alerts")
}

model InventorySettings {
  id                String   @id @default(uuid()) @db.Uuid
  shopId            String?  @db.Uuid
  lowStockThreshold Int      @default(10) @db.Integer
  reservationTimeout Int     @default(15) @db.Integer
  enableAutoRestock Boolean  @default(false)
  restockThreshold  Int?     @db.Integer
  restockQuantity   Int?     @db.Integer
  metadata          Json?
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  @@unique([shopId])
  @@map("inventory_settings")
}

// ── Marketing ────────────────────────────────────────────────────────────────

model Coupon {
  id             String     @id @default(uuid()) @db.Uuid
  code           String     @unique @db.VarChar(60)
  type           CouponType @default(percentage)
  value          Decimal    @db.Decimal(10, 2)
  maxDiscount    Decimal?   @db.Decimal(10, 2)
  minOrderAmount Decimal?   @db.Decimal(10, 2)
  maxUses        Int?       @db.Integer
  usedCount      Int        @default(0) @db.Integer
  validFrom      DateTime?  @db.Timestamptz(6)
  validUntil     DateTime?  @db.Timestamptz(6)
  isActive       Boolean    @default(true)
  shopId         String?    @db.Uuid
  createdAt      DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(6)

  shop           Shop?      @relation(fields: [shopId], references: [id])

  @@index([validUntil])
  @@index([shopId])
  @@map("coupons")
}

// ── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @db.Uuid
  type      NotificationType   @default(order_update)
  channel   NotificationChannel @default(in_app)
  title     String             @db.VarChar(255)
  body      String             @db.Text
  link      String?            @db.Text
  status    NotificationStatus @default(unread)
  readAt    DateTime?          @db.Timestamptz(6)
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now()) @db.Timestamptz(6)

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([createdAt])
  @@map("notifications")
}

// ── Search Index (binding: SEARCH_ENGINE_ARCHITECTURE.md §7) ───────────────────────

model SearchDocument {
  id               String   @id @default(uuid()) @db.Uuid
  productId        String?  @db.Uuid
  name             String   @db.VarChar(255)
  description      String?  @db.Text
  categoryName     String?  @db.VarChar(120)
  brand            String?  @db.VarChar(120)
  tags             String[]
  price            Decimal? @db.Decimal(10, 2)
  rating           Decimal? @db.Decimal(3, 2)
  reviewCount      Int?     @db.Integer
  stockStatus      String?  @db.VarChar(50)
  popularityScore  Decimal  @default(0) @db.Decimal(10, 2)
  recencyScore     Decimal  @default(0) @db.Decimal(10, 2)
  businessBoost    Decimal  @default(1.0) @db.Decimal(5, 2)
  attributes       Json?
  updatedAt        DateTime @default(now()) @db.Timestamptz(6)

  @@unique([productId])
  @@index([name])
  @@index([categoryName])
  @@index([brand])
  @@index([price])
  @@index([rating])
  @@index([stockStatus])
  @@index([popularityScore])
  @@index([recencyScore])
  @@map("search_documents")
}

model SearchHistory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  guestId   String?  @db.VarChar(64)
  query     String   @db.VarChar(200)
  results   Int      @default(0) @db.Integer
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([userId])
  @@index([guestId])
  @@index([createdAt])
  @@map("search_history")
}

model TrendingSearch {
  id        String   @id @default(uuid()) @db.Uuid
  query     String   @unique @db.VarChar(200)
  count     Int      @default(0) @db.Integer
  window    String   @default("7d") @db.VarChar(10)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([count])
  @@index([window])
  @@map("trending_searches")
}

// ---------------------------------------------------------------------------
// Payment & Finance Engine tables
// Source: DATABASE_SPECIFICATION.md §4.7/§4.9, PAYMENT_ENGINE_ARCHITECTURE.md,
// FINANCE_ENGINE_ARCHITECTURE.md, MASTER_ARCHITECTURE_BLUEPRINT.md B.3/B.4.
// All finance rows are append-only facts; corrections are new rows (reversal).
// ---------------------------------------------------------------------------

enum ShopMemberRole {
  manager
  staff
}

enum ShopMemberStatus {
  invited
  active
  suspended
  removed
}

enum ShopInviteStatus {
  pending
  accepted
  expired
  revoked
}

model Shop {
  id            String          @id @default(uuid()) @db.Uuid
  ownerId       String          @unique @db.Uuid
  name          String          @db.VarChar(120)
  slug          String          @unique @db.VarChar(120)
  status        ShopStatus      @default(pending)
  payoutMethod  PayoutMethod    @default(digital)
  payoutDetails Json?           @db.Json
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(6)

  owner          User            @relation(fields: [ownerId], references: [id])
  products       Product[]
  orders         Order[]
  settlements    Settlement[]
  payouts        Payout[]
  payoutAccounts PayoutAccount[]
  commissionRates CommissionRate[]
  coupons        Coupon[]
  members        ShopMember[]
  invites        ShopInvite[]

  @@index([status])
  @@map("shops")
}

model ShopMember {
  id        String           @id @default(uuid()) @db.Uuid
  shopId    String           @db.Uuid
  userId    String           @db.Uuid
  role      ShopMemberRole   @default(staff)
  status    ShopMemberStatus @default(active)
  invitedBy String?          @db.Uuid
  createdAt DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @db.Timestamptz(6)

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shopId, userId])
  @@index([shopId, status])
  @@index([userId])
  @@map("shop_members")
}

model ShopInvite {
  id            String            @id @default(uuid()) @db.Uuid
  shopId        String            @db.Uuid
  email         String            @db.VarChar(320)
  role          ShopMemberRole    @default(staff)
  tokenHash     String            @unique @db.VarChar(64)
  status        ShopInviteStatus  @default(pending)
  expiresAt     DateTime          @db.Timestamptz(6)
  invitedBy     String            @db.Uuid
  createdAt     DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(6)

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, status])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("shop_invites")
}

model PayoutAccount {
  id        String            @id @default(uuid()) @db.Uuid
  shopId    String            @db.Uuid
  type      PayoutAccountType
  details   Json              @db.Json
  isDefault Boolean           @default(false)
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt DateTime          @updatedAt @db.Timestamptz(6)

  shop      Shop              @relation(fields: [shopId], references: [id])
  payouts   Payout[]

  @@index([shopId])
  @@map("payout_accounts")
}

// Immutable gateway transaction record (binding: DATABASE §4.7.3). Append-only.
model PaymentTransaction {
  id               String                    @id @default(uuid()) @db.Uuid
  paymentId        String                    @db.Uuid
  type             PaymentTransactionType
  amount           Decimal                   @db.Decimal(10, 2)
  currency         String                    @default("INR") @db.VarChar(3)
  status           PaymentTransactionStatus  @default(pending)
  gatewayReference String?                   @db.VarChar(120)
  gatewayResponse  Json?                     @db.Json
  failureCode      String?                   @db.VarChar(80)
  failureMessage   String?                   @db.Text
  idempotencyKey   String                    @db.VarChar(120)
  createdAt        DateTime                  @default(now()) @db.Timestamptz(6)

  payment          Payment                   @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([idempotencyKey])
  @@index([paymentId])
  @@index([gatewayReference])
  @@map("payment_transactions")
}

// Inbound webhook idempotency + replay log (binding: REST §9.3, PAY-07).
model WebhookEvent {
  id            String             @id @default(uuid()) @db.Uuid
  provider      String             @db.VarChar(40)
  eventId       String             @db.VarChar(120)
  eventType     String             @db.VarChar(80)
  payloadHash   String             @db.VarChar(64)
  payload       String?            @db.Text
  status        WebhookEventStatus @default(received)
  failureReason String?            @db.Text
  processedAt   DateTime?          @db.Timestamptz(6)
  createdAt     DateTime           @default(now()) @db.Timestamptz(6)

  @@unique([provider, eventId])
  @@index([status])
  @@map("webhook_events")
}

// Master ledger of every financial event for an order (binding: DATABASE §4.9.1,
// FINANCE §5, ML-10 — records created on order confirmed).
model FinanceRecord {
  id            String              @id @default(uuid()) @db.Uuid
  orderId       String              @db.Uuid
  recordNumber  String              @unique @db.VarChar(30)
  type          FinanceRecordType
  amount        Decimal             @db.Decimal(10, 2)
  currency      String              @default("INR") @db.VarChar(3)
  status        FinanceRecordStatus @default(pending)
  referenceType String?             @db.VarChar(50)
  referenceId   String?             @db.Uuid
  metadata      Json?               @db.Json
  postedAt      DateTime?           @db.Timestamptz(6)
  createdAt     DateTime            @default(now()) @db.Timestamptz(6)

  order         Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ledgerEntries LedgerEntry[]

  @@index([orderId])
  @@index([referenceType, referenceId])
  @@map("finance_records")
}

// Double-entry posting detail — every FinanceRecord's entries sum to zero
// (binding: DATABASE §4.9.2). Append-only.
model LedgerEntry {
  id              String        @id @default(uuid()) @db.Uuid
  financeRecordId String        @db.Uuid
  account         LedgerAccount
  side            LedgerSide
  amount          Decimal       @db.Decimal(10, 2)
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)

  financeRecord   FinanceRecord @relation(fields: [financeRecordId], references: [id], onDelete: Cascade)

  @@index([financeRecordId])
  @@index([account])
  @@map("ledger_entries")
}

// Seller payout cycle per shop per period (binding: DATABASE §4.9.3,
// FINANCE §4, Blueprint B.4). Idempotent per (shopId, periodStart, periodEnd).
model Settlement {
  id               String           @id @default(uuid()) @db.Uuid
  settlementNumber String           @unique @db.VarChar(30)
  shopId           String           @db.Uuid
  periodStart      DateTime         @db.Timestamptz(6)
  periodEnd        DateTime         @db.Timestamptz(6)
  status           SettlementStatus @default(pending)
  grossAmount      Decimal          @db.Decimal(10, 2)
  commissionAmount Decimal          @default(0) @db.Decimal(10, 2)
  refundAdjustment Decimal          @default(0) @db.Decimal(10, 2)
  netAmount        Decimal          @db.Decimal(10, 2)
  currency         String           @default("INR") @db.VarChar(3)
  payoutMethod     PayoutMethod     @default(digital)
  payoutReference  String?          @db.VarChar(120)
  payoutGatewayReference String?    @db.VarChar(120)
  approvalReason   String?          @db.Text
  rejectionReason  String?          @db.Text
  approvedBy       String?          @db.Uuid
  approvedAt       DateTime?        @db.Timestamptz(6)
  completedAt      DateTime?        @db.Timestamptz(6)
  paidAt           DateTime?        @db.Timestamptz(6)
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(6)

  shop             Shop             @relation(fields: [shopId], references: [id])
  items            SettlementItem[]
  payouts          Payout[]

  @@unique([shopId, periodStart, periodEnd])
  @@index([status])
  @@index([shopId])
  @@map("settlements")
}

// Settlement line detail per order (binding: DATABASE §4.9.4).
model SettlementItem {
  id               String     @id @default(uuid()) @db.Uuid
  settlementId     String     @db.Uuid
  orderId          String     @db.Uuid
  grossAmount      Decimal    @db.Decimal(10, 2)
  commissionAmount Decimal    @default(0) @db.Decimal(10, 2)
  refundAdjustment Decimal    @default(0) @db.Decimal(10, 2)
  netAmount        Decimal    @db.Decimal(10, 2)

  settlement       Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  order            Order      @relation(fields: [orderId], references: [id])

  @@unique([settlementId, orderId])
  @@index([orderId])
  @@map("settlement_items")
}

// Commission definitions — platform default + category/shop overrides
// (binding: DATABASE §4.9.5, FINANCE §3, ML-05). Versioned by date range;
// rates snapshot per order at confirmation — never applied retroactively.
model CommissionRate {
  id            String           @id @default(uuid()) @db.Uuid
  scope         CommissionScope
  shopId        String?          @db.Uuid
  categoryId    String?          @db.Uuid
  rate          Decimal          @db.Decimal(4, 2)
  effectiveFrom DateTime         @db.Date
  effectiveTo   DateTime?        @db.Date
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(6)

  shop           Shop?            @relation(fields: [shopId], references: [id])
  category       Category?        @relation(fields: [categoryId], references: [id])

  @@index([scope, shopId, effectiveFrom])
  @@map("commission_rates")
}

// Actual money movement to seller account (binding: DATABASE §4.9.6).
model Payout {
  id              String        @id @default(uuid()) @db.Uuid
  settlementId    String        @db.Uuid
  shopId          String        @db.Uuid
  payoutAccountId String?       @db.Uuid
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("INR") @db.VarChar(3)
  status          PayoutStatus  @default(queued)
  batchReference  String?       @db.VarChar(120)
  requestedAt     DateTime      @default(now()) @db.Timestamptz(6)
  completedAt     DateTime?     @db.Timestamptz(6)

  settlement      Settlement    @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  shop            Shop          @relation(fields: [shopId], references: [id])
  payoutAccount   PayoutAccount? @relation(fields: [payoutAccountId], references: [id])

  @@index([shopId, status])
  @@index([status])
  @@map("payouts")
}

// COD-specific facts (binding: DATABASE §4.7.5, ML-08). No authorization;
// settlement eligibility drives on paid_to_seller.
model CodOrder {
  id            String        @id @default(uuid()) @db.Uuid
  orderId       String        @unique @db.Uuid
  codLimit      Decimal       @db.Decimal(10, 2)
  status        CodOrderStatus @default(awaiting_pickup)
  cashCollected Decimal?      @db.Decimal(10, 2)
  collectedAt   DateTime?     @db.Timestamptz(6)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(6)

  order         Order         @relation(fields: [orderId], references: [id])

  @@map("cod_orders")
}

// Saved instruments & tokens — PCI-safe, no PAN stored (binding: DATABASE §4.7.2).
model SavedPaymentMethod {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @db.Uuid
  type              PaymentMethod
  providerTokenHash String        @unique @db.VarChar(64)
  displayLabel      String        @db.VarChar(100)
  expiryMonth       Int?          @db.Integer
  expiryYear        Int?          @db.Integer
  isDefault         Boolean       @default(false)
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(6)

  user              User          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("saved_payment_methods")
}

// ── Customer Account Center tables (binding: CUSTOMER_ACCOUNT_PROFILE_ARCHITECTURE.md) ──

// Customer preferences for theme, locale, communication, privacy, marketing
model CustomerPreference {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @unique @db.Uuid
  theme         String   @default("auto") @db.VarChar(20) // light, dark, auto
  locale        String   @default("en-IN") @db.VarChar(10) // en-IN, bn-IN, hi-IN
  emailEnabled  Boolean  @default(true)
  smsEnabled    Boolean  @default(false)
  pushEnabled   Boolean  @default(true)
  inAppEnabled Boolean  @default(true)
  profileVisibility Boolean @default(true)
  showActivityStatus Boolean @default(true)
  allowAnalytics Boolean @default(true)
  allowPersonalization Boolean @default(true)
  emailConsent  Boolean  @default(false)
  smsConsent    Boolean  @default(false)
  pushConsent   Boolean  @default(false)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("customer_preferences")
}

// Notification preferences per category and channel
model NotificationPreference {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @db.Uuid
  orderUpdates    Boolean  @default(true)
  shipmentUpdates Boolean  @default(true)
  paymentUpdates  Boolean  @default(true)
  promotional     Boolean  @default(false)
  system          Boolean  @default(true)
  emailEnabled    Boolean  @default(true)
  smsEnabled      Boolean  @default(false)
  pushEnabled     Boolean  @default(true)
  inAppEnabled    Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notification_preferences")
}

// Recently viewed products for customer
model RecentlyViewed {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  productId String   @db.Uuid
  viewedAt  DateTime @default(now()) @db.Timestamptz(6)

  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, productId])
  @@index([userId, viewedAt])
  @@map("recently_viewed")
}

model AppSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(64)
  value     Json     @db.Json
  updatedBy String?  @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@map("app_settings")
}
