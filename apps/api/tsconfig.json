{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types"],
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "outDir": "./dist",
    "rootDir": ".",
    "composite": false
  },
  "include": [
    "vitest.config.ts",
    "vitest.integration.config.ts",
    "functions/**/*",
    "_lib/**/*",
    "_handlers/**/*",
    "prisma/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
