{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nabome-api",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "vars": {
    "ENVIRONMENT": "production",
    "PAYMENT_PROVIDER": "razorpay",
    "FINANCE_COMMISSION_RATE": "15",
    "FINANCE_COMMISSION_CAP": "50",
    "FINANCE_HOLD_DAYS": "7",
    "FINANCE_SETTLEMENT_MIN": "100",
    "COD_ENABLED": "true",
    "COD_MAX_AMOUNT": "5000",
    "PUBLIC_API_URL": "https://api.nabome.online",
    "APP_URL": "https://nabome.online",
    "LOG_LEVEL": "info",
    "SESSION_COOKIE_NAME": "nabome_session",
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "6969b592bba74117b3f27545dcf47e7a",
      "preview_id": "7cb2d643a3ed4165ad24eb7814643027",
    },
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "e2b5c6e70f164e189bebf1cc1282428f",
      "localConnectionString": "postgres://nabome:nabome@localhost:5432/nabome",
    },
  ],
  "env": {
    "preview": {
      "name": "nabome-api-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "PAYMENT_PROVIDER": "razorpay",
        "FINANCE_COMMISSION_RATE": "15",
        "FINANCE_COMMISSION_CAP": "50",
        "FINANCE_HOLD_DAYS": "7",
        "FINANCE_SETTLEMENT_MIN": "100",
        "COD_ENABLED": "true",
        "COD_MAX_AMOUNT": "5000",
        "PUBLIC_API_URL": "https://staging-api.nabome.online",
        "APP_URL": "https://staging.nabome.online",
        "LOG_LEVEL": "debug",
        "SESSION_COOKIE_NAME": "nabome_session",
      },
      "kv_namespaces": [
        {
          "binding": "KV",
          "id": "2db98525861f455c8b80e902569933d7",
          "preview_id": "7cb2d643a3ed4165ad24eb7814643027",
        },
      ],
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "e2b5c6e70f164e189bebf1cc1282428f",
        },
      ],
    },
    "production": {
      "name": "nabome-api",
      "vars": {
        "ENVIRONMENT": "production",
        "PAYMENT_PROVIDER": "razorpay",
        "FINANCE_COMMISSION_RATE": "15",
        "FINANCE_COMMISSION_CAP": "50",
        "FINANCE_HOLD_DAYS": "7",
        "FINANCE_SETTLEMENT_MIN": "100",
        "COD_ENABLED": "true",
        "COD_MAX_AMOUNT": "5000",
        "PUBLIC_API_URL": "https://api.nabome.online",
        "APP_URL": "https://nabome.online",
        "LOG_LEVEL": "info",
        "SESSION_COOKIE_NAME": "nabome_session",
      },
      "kv_namespaces": [
        { "binding": "KV", "id": "6969b592bba74117b3f27545dcf47e7a" },
      ],
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "e2b5c6e70f164e189bebf1cc1282428f",
        },
      ],
    },
  },
}
