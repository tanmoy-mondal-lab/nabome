{
  "name": "@nabome/api",
  "version": "0.1.0",
  "private": true,
  "description": "Nabome Backend API — Cloudflare Pages Functions (no framework)",
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev --port 8788",
    "build": "mkdir -p dist && cp -r functions _lib _handlers prisma dist/ 2>/dev/null || true",
    "preview": "wrangler pages dev ./dist --port 8788",
    "lint": "eslint functions _lib _handlers prisma",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "deploy:staging": "wrangler pages deploy dist --project-name nabome-api-staging",
    "deploy:prod": "wrangler pages deploy dist --project-name nabome-api"
  },
  "dependencies": {
    "@nabome/api-contracts": "workspace:*",
    "@nabome/auth": "workspace:*",
    "@nabome/config": "workspace:*",
    "@nabome/constants": "workspace:*",
    "@nabome/finance": "workspace:*",
    "@nabome/logging": "workspace:*",
    "@nabome/payment": "workspace:*",
    "@nabome/shipping": "workspace:*",
    "@nabome/types": "workspace:*",
    "@nabome/validation": "workspace:*",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "6.19.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "aws4fetch": "^1.0.20",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@prisma/adapter-neon": "^6.19.3",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "prisma": "6.19.3",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}
