{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "chrome",
      "request": "launch",
      "name": "Debug customer app (5173)",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/apps/customer/src",
      "preLaunchTask": "dev:customer"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Debug admin app (5174)",
      "url": "http://localhost:5174",
      "webRoot": "${workspaceFolder}/apps/admin/src",
      "preLaunchTask": "dev:admin"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Debug shop app (5175)",
      "url": "http://localhost:5175",
      "webRoot": "${workspaceFolder}/apps/shop/src",
      "preLaunchTask": "dev:shop"
    },
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "Debug API (wrangler dev, 8788)",
      "command": "pnpm dev:api",
      "cwd": "${workspaceFolder}",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
