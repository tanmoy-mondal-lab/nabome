model JobQueue {
  id            String      @id @default(uuid()) @db.Uuid
  jobType       String      @map("job_type") @db.VarChar(100)
  payload       Json
  status        JobStatus   @default(pending)
  priority      Int         @default(0)
  maxRetries    Int         @default(3) @map("max_retries")
  retryCount    Int         @default(0) @map("retry_count")
  retryAfter    DateTime?   @map("retry_after") @db.Timestamptz(6)
  errorMessage  String?     @map("error_message")
  startedAt     DateTime?   @map("started_at") @db.Timestamptz(6)
  completedAt   DateTime?   @map("completed_at") @db.Timestamptz(6)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, priority, createdAt])
  @@index([status, retryAfter])
  @@index([jobType])
  @@map("job_queue")
}

model DeadLetterQueue {
  id              String      @id @default(uuid()) @db.Uuid
  jobType         String      @map("job_type") @db.VarChar(100)
  payload         Json
  errorMessage    String      @map("error_message")
  retryCount      Int         @map("retry_count")
  originalJobId   String?     @map("original_job_id") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([jobType, createdAt])
  @@map("dead_letter_queue")
}
