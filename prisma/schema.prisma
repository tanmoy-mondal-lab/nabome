model notification_templates {
  id        String            @id @default(uuid()) @db.Uuid
  event     NotificationEvent @unique
  subject   String            @db.VarChar(500)
  emailBody String?           @map("email_body")
  smsBody   String?           @map("sms_body") @db.VarChar(500)
  inAppBody String?           @map("in_app_body") @db.VarChar(500)
  isActive  Boolean           @default(true) @map("is_active")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

}

model support_tickets {
  id         String                @id @default(uuid()) @db.Uuid
  orderId    String?               @map("order_id") @db.Uuid
  profileId  String?               @map("profile_id") @db.Uuid
  name       String                @db.VarChar(200)
  email      String                @db.VarChar(255)
  subject    String                @db.VarChar(500)
  message    String
  status     SupportTicketStatus   @default(open)
  priority   SupportTicketPriority @default(medium)
  assignedTo String?               @map("assigned_to") @db.Uuid
  resolvedAt DateTime?             @map("resolved_at") @db.Timestamptz(6)
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")
  replies    support_ticket_replies[]
  assignee   profiles?              @relation("AssignedSupport", fields: [assignedTo], references: [id])
  order      orders?                @relation(fields: [orderId], references: [id])
  profile    profiles?              @relation(fields: [profileId], references: [id])

  @@index([status])
  @@index([priority])
  @@index([profileId])
  @@index([orderId])
  @@index([assignedTo])
  @@index([status, priority])
}

model support_ticket_replies {
  id        String        @id @default(uuid()) @db.Uuid
  ticketId  String        @map("ticket_id") @db.Uuid
  profileId String?       @map("profile_id") @db.Uuid
  message   String
  isStaff   Boolean       @default(false) @map("is_staff")
  createdAt DateTime      @default(now()) @map("created_at")
  author    profiles?      @relation(fields: [profileId], references: [id])
  ticket    support_tickets @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([profileId])
}

model faqs {
  id        String   @id @default(uuid()) @db.Uuid
  question  String
  answer    String
  category  String?  @db.VarChar(100)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([category, isActive])
  @@index([sortOrder])
}

model currencies {
  code             String   @id @db.VarChar(3)
  name             String   @db.VarChar(100)
  symbol           String   @db.VarChar(10)
  exchangeRate     Decimal  @default(1) @map("exchange_rate") @db.Decimal(12, 6)
  isBase           Boolean  @default(false) @map("is_base")
  isActive         Boolean  @default(false) @map("is_active")
  decimalPlaces    Int      @default(2) @map("decimal_places")
  formattingLocale String   @default("en-IN") @map("formatting_locale") @db.VarChar(10)
  updatedAt        DateTime @updatedAt @map("updated_at")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([isActive])
}

