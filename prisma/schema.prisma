generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres", "postgresqlExtensions"]
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "foreignKeys"
  extensions   = [pg_trgm, pgcrypto]
}

model Profile {
  id                          String                @id @default(uuid()) @db.Uuid
  role                        UserRole              @default(customer)
  email                       String                @unique @db.VarChar(255)
  firstName                   String                @map("first_name") @db.VarChar(100)
  lastName                    String?               @map("last_name") @db.VarChar(100)
  phone                       String?               @db.VarChar(20)
  avatarUrl                   String?               @map("avatar_url")
  isActive                    Boolean               @default(true) @map("is_active")
  emailVerified               Boolean               @default(false) @map("email_verified")
  verificationToken           String?               @map("verification_token") @db.VarChar(255)
  verificationTokenExpiresAt  DateTime?             @map("verification_token_expires_at") @db.Timestamptz(6)
  pendingEmail                String?               @map("pending_email") @db.VarChar(255)
  pendingEmailToken           String?               @map("pending_email_token") @db.VarChar(255)
  pendingEmailTokenExpiresAt  DateTime?             @map("pending_email_token_expires_at") @db.Timestamptz(6)
  resetPasswordToken          String?               @map("reset_password_token") @db.VarChar(255)
  resetPasswordTokenExpiresAt DateTime?             @map("reset_password_token_expires_at") @db.Timestamptz(6)
  lastLoginAt                 DateTime?             @map("last_login_at") @db.Timestamptz(6)
  loginCount                  Int                   @default(0) @map("login_count")
  preferences                 Json?
  phoneVerified               Boolean               @default(false) @map("phone_verified")
  marketingOptIn              Boolean               @default(true) @map("marketing_opt_in")
  notificationPreferences     Json?                 @map("notification_preferences")
  createdAt                   DateTime              @default(now()) @map("created_at")
  updatedAt                   DateTime              @updatedAt @map("updated_at")
  addresses                   Address[]
  sessions                    AuthSession[]
  cart                        Cart?
  couponRedemptions           CouponRedemption[]
  purchasedGiftCards          GiftCard[]            @relation("GiftCardPurchaser")
  redeemedGiftCards           GiftCard[]            @relation("GiftCardRedeemer")
  loginAttempts               LoginAttempt[]
  loyaltyPoints               LoyaltyPoints?
  notifications               Notification[]
  orderHistoryEntries         OrderStatusHistory[]
  orders                      Order[]
  referralCode                ReferralCode?
  referredReferrals           Referral[]            @relation("ReferredProfile")
  refunds                     Refund[]              @relation("RefundInitiator")
  returnRequests              ReturnRequest[]
  reviews                     Review[]
  subscriptions               Subscription[]
  supportReplies              SupportTicketReply[]
  assignedTickets             SupportTicket[]       @relation("AssignedSupport")
  supportTickets              SupportTicket[]
  userActionLogs              UserActionLog[]
  verificationAttempts        VerificationAttempt[]
  wishlistItems               WishlistItem[]
  searchHistory               SearchHistory[]

  @@index([role])
  @@index([isActive])
  @@index([createdAt])
  @@map("profiles")
}

model AuthSession {
  id                    String        @id @default(uuid()) @db.Uuid
  profileId             String        @map("profile_id") @db.Uuid
  accessToken           String        @unique @map("access_token")
  refreshToken          String        @unique @map("refresh_token")
  refreshTokenExpiresAt DateTime?     @map("refresh_token_expires_at") @db.Timestamptz(6)
  userAgent             String?       @map("user_agent")
  ipAddress             String?       @map("ip_address") @db.VarChar(45)
  deviceName            String?       @map("device_name") @db.VarChar(200)
  isActive              Boolean       @default(true) @map("is_active")
  revokedAt             DateTime?     @map("revoked_at") @db.Timestamptz(6)
  rotatedFromSessionId  String?       @map("rotated_from_session_id") @db.Uuid
  lastActiveAt          DateTime      @default(now()) @map("last_active_at") @db.Timestamptz(6)
  expiresAt             DateTime      @map("expires_at") @db.Timestamptz(6)
  createdAt             DateTime      @default(now()) @map("created_at")
  profile               Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  rotatedFrom           AuthSession?  @relation("SessionRotation", fields: [rotatedFromSessionId], references: [id])
  rotatedSessions       AuthSession[] @relation("SessionRotation")

  @@index([profileId, isActive])
  @@index([expiresAt])
  @@index([refreshTokenExpiresAt])
  @@index([rotatedFromSessionId])
  @@map("auth_sessions")
}

model LoginAttempt {
  id         String   @id @default(uuid()) @db.Uuid
  profileId  String?  @map("profile_id") @db.Uuid
  email      String   @db.VarChar(255)
  ipAddress  String   @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent")
  success    Boolean  @default(false)
  failReason String?  @map("fail_reason") @db.VarChar(100)
  createdAt  DateTime @default(now()) @map("created_at")
  profile    Profile? @relation(fields: [profileId], references: [id])

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@index([profileId])
  @@map("login_attempts")
}

model VerificationAttempt {
  id          String    @id @default(uuid()) @db.Uuid
  profileId   String?   @map("profile_id") @db.Uuid
  email       String    @db.VarChar(255)
  code        String    @db.VarChar(10)
  ipAddress   String    @map("ip_address") @db.VarChar(45)
  success     Boolean   @default(false)
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at")
  profile     Profile?  @relation(fields: [profileId], references: [id])

  @@index([email, code])
  @@index([ipAddress, createdAt])
  @@index([profileId])
  @@map("verification_attempts")
}

model UserActionLog {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String?  @map("profile_id") @db.Uuid
  action    String   @db.VarChar(100)
  entity    String?  @db.VarChar(100)
  entityId  String?  @map("entity_id") @db.VarChar(100)
  metadata  Json?
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  profile   Profile? @relation(fields: [profileId], references: [id])

  @@index([profileId])
  @@index([action, createdAt])
  @@index([entity, entityId])
  @@map("user_action_logs")
}

model ApiKey {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(200)
  key          String    @db.VarChar(255)
  version      Int       @default(1)
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(6)
  isDeprecated Boolean   @default(false) @map("is_deprecated")
  deprecatedAt DateTime? @map("deprecated_at") @db.Timestamptz(6)
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([isDeprecated])
  @@index([expiresAt])
  @@index([createdAt])
  @@map("api_keys")
}

model Category {
  id            String        @id @default(uuid()) @db.Uuid
  name          String        @db.VarChar(200)
  slug          String        @unique @db.VarChar(200)
  description   String?
  imageUrl      String?       @map("image_url")
  imagePublicId String?       @map("image_public_id") @db.VarChar(500)
  parentId      String?       @map("parent_id") @db.Uuid
  sortOrder     Int           @default(0) @map("sort_order")
  isActive      Boolean       @default(true) @map("is_active")
  metaTitle     String?       @map("meta_title") @db.VarChar(200)
  metaDesc      String?       @map("meta_desc")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  parent        Category?     @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children      Category[]    @relation("CategoryHierarchy")
  products      Product[]
  sizeGuides    SizeGuide[]
  subcategories Subcategory[]

  @@index([parentId])
  @@index([isActive])
  @@index([sortOrder])
  @@map("categories")
}

model Subcategory {
  id            String    @id @default(uuid()) @db.Uuid
  name          String    @db.VarChar(200)
  slug          String    @unique @db.VarChar(200)
  description   String?
  imageUrl      String?   @map("image_url")
  imagePublicId String?   @map("image_public_id") @db.VarChar(500)
  categoryId    String    @map("category_id") @db.Uuid
  sortOrder     Int       @default(0) @map("sort_order")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  products      Product[]
  category      Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade, map: "subcategories_category_id_fkey")

  @@index([categoryId])
  @@index([isActive])
  @@map("subcategories")
}

model Collection {
  id                String    @id @default(uuid()) @db.Uuid
  name              String    @db.VarChar(200)
  slug              String    @unique @db.VarChar(200)
  description       String?
  heroImageUrl      String?   @map("hero_image_url")
  heroImagePublicId String?   @map("hero_image_public_id") @db.VarChar(500)
  isActive          Boolean   @default(true) @map("is_active")
  isFeatured        Boolean   @default(false) @map("is_featured")
  startDate         DateTime? @map("start_date") @db.Timestamptz(6)
  endDate           DateTime? @map("end_date") @db.Timestamptz(6)
  sortOrder         Int       @default(0) @map("sort_order")
  metaTitle         String?   @map("meta_title") @db.VarChar(200)
  metaDesc          String?   @map("meta_desc")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  products          Product[]

  @@index([isFeatured])
  @@index([sortOrder])
  @@map("collections")
}

model Brand {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(200)
  slug         String    @unique @db.VarChar(200)
  description  String?
  logoUrl      String?   @map("logo_url")
  logoPublicId String?   @map("logo_public_id") @db.VarChar(500)
  websiteUrl   String?   @map("website_url")
  sortOrder    Int       @default(0) @map("sort_order")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  products     Product[]

  @@index([isActive])
  @@map("brands")
}

model SizeGuide {
  id            String    @id @default(uuid()) @db.Uuid
  name          String    @db.VarChar(200)
  slug          String    @unique @db.VarChar(200)
  description   String?
  categoryId    String?   @map("category_id") @db.Uuid
  type          String    @default("clothing") @db.VarChar(50)
  unit          String    @default("inches") @db.VarChar(20)
  imageUrl      String?   @map("image_url")
  imagePublicId String?   @map("image_public_id") @db.VarChar(500)
  measurements  Json
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  products      Product[]
  category      Category? @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@map("size_guides")
}

model InventoryAlert {
  id           String         @id @default(uuid()) @db.Uuid
  variantId    String         @map("variant_id") @db.Uuid
  type         String         @db.VarChar(50)
  message      String
  threshold    Int?           @db.SmallInt
  currentStock Int            @map("current_stock") @db.SmallInt
  isResolved   Boolean        @default(false) @map("is_resolved")
  resolvedAt   DateTime?      @map("resolved_at") @db.Timestamptz(6)
  createdAt    DateTime       @default(now()) @map("created_at")
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, isResolved])
  @@index([type, isResolved])
  @@index([createdAt])
  @@map("inventory_alerts")
}

model Product {
  id                 String                  @id @default(uuid()) @db.Uuid
  name               String                  @db.VarChar(300)
  slug               String                  @unique @db.VarChar(300)
  description        String?
  shortDescription   String?                 @map("short_description")
  categoryId         String?                 @map("category_id") @db.Uuid
  subcategoryId      String?                 @map("subcategory_id") @db.Uuid
  collectionId       String?                 @map("collection_id") @db.Uuid
  brandId            String?                 @map("brand_id") @db.Uuid
  basePrice          Decimal                 @map("base_price") @db.Decimal(10, 2)
  compareAtPrice     Decimal?                @map("compare_at_price") @db.Decimal(10, 2)
  costPrice          Decimal?                @map("cost_price") @db.Decimal(10, 2)
  salePrice          Decimal?                @map("sale_price") @db.Decimal(10, 2)
  discountPercent    Int?                    @map("discount_percent") @db.SmallInt
  currency           String                  @default("INR") @db.VarChar(3)
  material           String?                 @db.VarChar(200)
  careInstructions   String?                 @map("care_instructions")
  sizeChartUrl       String?                 @map("size_chart_url")
  sizeChartPublicId  String?                 @map("size_chart_public_id") @db.VarChar(500)
  sizeGuideId        String?                 @map("size_guide_id") @db.Uuid
  isActive           Boolean                 @default(true) @map("is_active")
  isFeatured         Boolean                 @default(false) @map("is_featured")
  isNew              Boolean                 @default(false) @map("is_new")
  gender             Gender                  @default(unisex)
  sortOrder          Int                     @default(0) @map("sort_order")
  publishedAt        DateTime?               @map("published_at") @db.Timestamptz(6)
  scheduledPublishAt DateTime?               @map("scheduled_publish_at") @db.Timestamptz(6)
  scheduledArchiveAt DateTime?               @map("scheduled_archive_at") @db.Timestamptz(6)
  metaTitle          String?                 @map("meta_title") @db.VarChar(200)
  metaDesc           String?                 @map("meta_desc")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")
  lookbookItems      LookbookItem[]
  orderItems         OrderItem[]
  attributes         ProductAttribute[]
  images             ProductImage[]
  productLabels      ProductLabelOnProduct[]
  productTags        ProductTagOnProduct[]
  variants           ProductVariant[]
  brand              Brand?                  @relation(fields: [brandId], references: [id])
  category           Category?               @relation(fields: [categoryId], references: [id])
  collection         Collection?             @relation(fields: [collectionId], references: [id])
  sizeGuide          SizeGuide?              @relation(fields: [sizeGuideId], references: [id])
  subcategory        Subcategory?            @relation(fields: [subcategoryId], references: [id])
  relatedTo          RelatedProduct[]        @relation("RelatedProductSource")
  relatedFrom        RelatedProduct[]        @relation("RelatedProductTarget")
  reviews            Review[]

  @@index([categoryId])
  @@index([subcategoryId])
  @@index([collectionId])
  @@index([brandId])
  @@index([isActive, isFeatured])
  @@index([isActive, isNew])
  @@index([isActive, gender, createdAt])
  @@index([isActive, categoryId, sortOrder])
  @@index([isActive, brandId, sortOrder])
  @@index([isActive, collectionId, sortOrder])
  @@index([isActive, collectionId, publishedAt])
  @@index([isActive, basePrice])
  @@index([isActive, basePrice, sortOrder])
  @@index([isActive, categoryId, gender])
  @@index([scheduledPublishAt])
  @@index([scheduledArchiveAt])
  @@index([createdAt])
  @@map("products")
}

model ProductVariant {
  id                 String              @id @default(uuid()) @db.Uuid
  productId          String              @map("product_id") @db.Uuid
  sku                String              @unique @db.VarChar(100)
  size               String              @db.VarChar(50)
  color              String              @db.VarChar(100)
  colorHex           String?             @map("color_hex") @db.VarChar(7)
  priceAdjustment    Decimal             @default(0) @map("price_adjustment") @db.Decimal(10, 2)
  stock              Int                 @default(0)
  reservedStock      Int                 @default(0) @map("reserved_stock")
  weight             Decimal?            @db.Decimal(8, 2)
  videoUrl           String?             @map("video_url")
  videoPublicId      String?             @map("video_public_id") @db.VarChar(500)
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  cartItems          CartItem[]
  inventoryAlerts    InventoryAlert[]
  inventoryMovements InventoryMovement[]
  orderItems         OrderItem[]
  images             ProductImage[]
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  wishlistItems      WishlistItem[]

  @@unique([productId, size, color])
  @@index([productId])
  @@index([productId, isActive])
  @@index([size, color])
  @@index([isActive, stock])
  @@map("product_variants")
}

model ProductImage {
  id        String          @id @default(uuid()) @db.Uuid
  productId String          @map("product_id") @db.Uuid
  variantId String?         @map("variant_id") @db.Uuid
  url       String
  publicId  String?         @map("public_id") @db.VarChar(500)
  altText   String?         @map("alt_text") @db.VarChar(500)
  sortOrder Int             @default(0) @map("sort_order")
  isPrimary Boolean         @default(false) @map("is_primary")
  type      String?         @default("image") @db.VarChar(20)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([productId])
  @@index([variantId])
  @@index([isPrimary])
  @@map("product_images")
}

model ProductAttribute {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  name      String  @db.VarChar(100)
  value     String  @db.VarChar(200)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([name])
  @@map("product_attributes")
}

model RelatedProduct {
  id        String   @id @default(uuid()) @db.Uuid
  sourceId  String   @map("source_id") @db.Uuid
  targetId  String   @map("target_id") @db.Uuid
  type      String   @default("related") @db.VarChar(50)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  source    Product  @relation("RelatedProductSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target    Product  @relation("RelatedProductTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, type])
  @@index([sourceId, type])
  @@index([targetId, type])
  @@map("related_products")
}

model ProductTag {
  id        String                @id @default(uuid()) @db.Uuid
  name      String                @unique @db.VarChar(100)
  slug      String                @unique @db.VarChar(200)
  createdAt DateTime              @default(now()) @map("created_at")
  products  ProductTagOnProduct[]

  @@map("product_tags")
}

model ProductTagOnProduct {
  productId String     @map("product_id") @db.Uuid
  tagId     String     @map("tag_id") @db.Uuid
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       ProductTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
  @@map("product_tags_products")
}

model ProductLabel {
  id        String                  @id @default(uuid()) @db.Uuid
  name      String                  @db.VarChar(100)
  slug      String                  @unique @db.VarChar(200)
  color     String?                 @db.VarChar(7)
  createdAt DateTime                @default(now()) @map("created_at")
  products  ProductLabelOnProduct[]

  @@map("product_labels")
}

model ProductLabelOnProduct {
  productId String       @map("product_id") @db.Uuid
  labelId   String       @map("label_id") @db.Uuid
  label     ProductLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, labelId])
  @@index([labelId])
  @@map("product_labels_products")
}

model InventoryMovement {
  id             String         @id @default(uuid()) @db.Uuid
  variantId      String         @map("variant_id") @db.Uuid
  quantityChange Int            @map("quantity_change")
  stockAfter     Int            @map("stock_after")
  reason         String         @db.VarChar(200)
  referenceId    String?        @map("reference_id") @db.VarChar(100)
  note           String?
  createdAt      DateTime       @default(now()) @map("created_at")
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@index([createdAt])
  @@index([reason])
  @@map("inventory_movements")
}

model Address {
  id               String   @id @default(uuid()) @db.Uuid
  profileId        String   @map("profile_id") @db.Uuid
  label            String   @default("Home") @db.VarChar(50)
  fullName         String   @map("full_name") @db.VarChar(200)
  phone            String   @db.VarChar(20)
  line1            String   @db.VarChar(500)
  line2            String?  @db.VarChar(500)
  city             String   @db.VarChar(200)
  district         String?  @map("district") @db.VarChar(200)
  state            String   @db.VarChar(200)
  pincode          String   @db.VarChar(10)
  country          String   @default("India") @db.VarChar(100)
  isDefault        Boolean  @default(false) @map("is_default")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  isBillingDefault Boolean  @default(false) @map("is_billing_default")
  addressType      String   @default("shipping") @map("address_type") @db.VarChar(20)
  profile          Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  ordersAsBilling  Order[]  @relation("BillingAddress")
  ordersAsShipping Order[]  @relation("ShippingAddress")

  @@index([profileId])
  @@index([pincode])
  @@map("addresses")
}

model WishlistItem {
  id        String         @id @default(uuid()) @db.Uuid
  profileId String         @map("profile_id") @db.Uuid
  variantId String         @map("variant_id") @db.Uuid
  createdAt DateTime       @default(now()) @map("created_at")
  profile   Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([profileId, variantId])
  @@map("wishlist_items")
}

model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  profileId String     @unique @map("profile_id") @db.Uuid
  expiresAt DateTime?  @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  items     CartItem[]
  profile   Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("carts")
}

model CartItem {
  id            String         @id @default(uuid()) @db.Uuid
  cartId        String         @map("cart_id") @db.Uuid
  variantId     String         @map("variant_id") @db.Uuid
  quantity      Int            @default(1)
  savedForLater Boolean        @default(false) @map("saved_for_later")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  cart          Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@map("cart_items")
}

model Order {
  id                 String               @id @default(uuid()) @db.Uuid
  orderNumber        String               @unique @map("order_number") @db.VarChar(50)
  profileId          String?              @map("profile_id") @db.Uuid
  email              String               @db.VarChar(255)
  status             OrderStatus          @default(pending)
  subtotal           Decimal              @db.Decimal(10, 2)
  shippingCost       Decimal              @default(0) @map("shipping_cost") @db.Decimal(10, 2)
  tax                Decimal              @default(0) @db.Decimal(10, 2)
