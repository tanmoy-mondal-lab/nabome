  updatedAt    DateTime            @updatedAt @map("updated_at")
  order        Order?              @relation(fields: [orderId], references: [id])
  profile      Profile?            @relation(fields: [profileId], references: [id])

  @@index([profileId, isRead])
  @@index([profileId, createdAt])
  @@index([orderId])
  @@index([channel, sentAt])
  @@map("notifications")
}

model NotificationTemplate {
  id        String            @id @default(uuid()) @db.Uuid
  event     NotificationEvent @unique
  subject   String            @db.VarChar(500)
  emailBody String?           @map("email_body")
  smsBody   String?           @map("sms_body") @db.VarChar(500)
  inAppBody String?           @map("in_app_body") @db.VarChar(500)
  isActive  Boolean           @default(true) @map("is_active")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  @@map("notification_templates")
}

model SupportTicket {
  id         String                @id @default(uuid()) @db.Uuid
  orderId    String?               @map("order_id") @db.Uuid
  profileId  String?               @map("profile_id") @db.Uuid
  name       String                @db.VarChar(200)
  email      String                @db.VarChar(255)
  subject    String                @db.VarChar(500)
  message    String
  status     SupportTicketStatus   @default(open)
  priority   SupportTicketPriority @default(medium)
  assignedTo String?               @map("assigned_to") @db.Uuid
  resolvedAt DateTime?             @map("resolved_at") @db.Timestamptz(6)
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")
  replies    SupportTicketReply[]
  assignee   Profile?              @relation("AssignedSupport", fields: [assignedTo], references: [id])
  order      Order?                @relation(fields: [orderId], references: [id])
  profile    Profile?              @relation(fields: [profileId], references: [id])

  @@index([status])
  @@index([priority])
  @@index([profileId])
  @@index([orderId])
  @@index([assignedTo])
  @@index([status, priority])
  @@map("support_tickets")
}

model SupportTicketReply {
  id        String        @id @default(uuid()) @db.Uuid
  ticketId  String        @map("ticket_id") @db.Uuid
  profileId String?       @map("profile_id") @db.Uuid
  message   String
  isStaff   Boolean       @default(false) @map("is_staff")
  createdAt DateTime      @default(now()) @map("created_at")
  author    Profile?      @relation(fields: [profileId], references: [id])
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([profileId])
  @@map("support_ticket_replies")
}

model FAQ {
  id        String   @id @default(uuid()) @db.Uuid
  question  String
  answer    String
  category  String?  @db.VarChar(100)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([category, isActive])
  @@index([sortOrder])
  @@map("faqs")
}

model LoyaltyPoints {
  id             String               @id @default(uuid()) @db.Uuid
  profileId      String               @unique @map("profile_id") @db.Uuid
  points         Int                  @default(0)
  tier           String               @default("bronze") @db.VarChar(50)
  lifetimePoints Int                  @default(0) @map("lifetime_points")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  profile        Profile              @relation(fields: [profileId], references: [id], onDelete: Cascade)
  transactions   LoyaltyTransaction[]

  @@index([tier])
  @@map("loyalty_points")
}

model LoyaltyTransaction {
  id              String        @id @default(uuid()) @db.Uuid
  loyaltyPointsId String        @map("loyalty_points_id") @db.Uuid
  points          Int
  type            String        @db.VarChar(50)
  description     String?       @db.VarChar(500)
  referenceId     String?       @map("reference_id") @db.VarChar(100)
  referenceType   String?       @map("reference_type") @db.VarChar(50)
  expiresAt       DateTime?     @map("expires_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at")
  loyaltyPoints   LoyaltyPoints @relation(fields: [loyaltyPointsId], references: [id], onDelete: Cascade)

  @@index([loyaltyPointsId])
  @@index([type])
  @@index([createdAt])
  @@map("loyalty_transactions")
}

model LoyaltyTier {
  id               String   @id @default(uuid()) @db.Uuid
  name             String   @unique @db.VarChar(50)
  minPoints        Int      @default(0) @map("min_points")
  discountPercent  Int      @default(0) @map("discount_percent")
  freeShipping     Boolean  @default(false) @map("free_shipping")
  pointsMultiplier Decimal  @default(1) @map("points_multiplier") @db.Decimal(3, 1)
  badgeColor       String?  @map("badge_color") @db.VarChar(7)
  description      String?
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("loyalty_tiers")
}

model ReferralCode {
  id             String     @id @default(uuid()) @db.Uuid
  profileId      String     @unique @map("profile_id") @db.Uuid
  code           String     @unique @db.VarChar(50)
  totalReferrals Int        @default(0) @map("total_referrals")
  totalRewards   Decimal    @default(0) @map("total_rewards") @db.Decimal(10, 2)
  isActive       Boolean    @default(true) @map("is_active")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  profile        Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  referrals      Referral[]

  @@index([code])
  @@map("referral_codes")
}

model Referral {
  id                String       @id @default(uuid()) @db.Uuid
  referrerCodeId    String       @map("referrer_code_id") @db.Uuid
  referredEmail     String       @map("referred_email") @db.VarChar(255)
  referredProfileId String?      @map("referred_profile_id") @db.Uuid
  status            String       @default("pending") @db.VarChar(50)
  rewardAmount      Decimal?     @map("reward_amount") @db.Decimal(10, 2)
  rewardGivenAt     DateTime?    @map("reward_given_at") @db.Timestamptz(6)
  orderId           String?      @map("order_id") @db.Uuid
  expiresAt         DateTime?    @map("expires_at") @db.Timestamptz(6)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  order             Order?       @relation(fields: [orderId], references: [id])
  referredProfile   Profile?     @relation("ReferredProfile", fields: [referredProfileId], references: [id])
  referrerCode      ReferralCode @relation(fields: [referrerCodeId], references: [id], onDelete: Cascade)

  @@index([referrerCodeId])
  @@index([referredEmail])
  @@index([status])
  @@index([createdAt])
  @@map("referrals")
}

model GiftCard {
  id             String    @id @default(uuid()) @db.Uuid
  code           String    @unique @db.VarChar(50)
  initialBalance Decimal   @map("initial_balance") @db.Decimal(10, 2)
  currentBalance Decimal   @map("current_balance") @db.Decimal(10, 2)
  currency       String    @default("INR") @db.VarChar(3)
  senderName     String?   @map("sender_name") @db.VarChar(200)
  senderEmail    String?   @map("sender_email") @db.VarChar(255)
  recipientName  String?   @map("recipient_name") @db.VarChar(200)
  recipientEmail String?   @map("recipient_email") @db.VarChar(255)
  message        String?
  purchasedById  String?   @map("purchased_by_id") @db.Uuid
  redeemedById   String?   @map("redeemed_by_id") @db.Uuid
  orderId        String?   @map("order_id") @db.Uuid
  isActive       Boolean   @default(true) @map("is_active")
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(6)
  redeemedAt     DateTime? @map("redeemed_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  order          Order?    @relation(fields: [orderId], references: [id])
  purchasedBy    Profile?  @relation("GiftCardPurchaser", fields: [purchasedById], references: [id])
  redeemedBy     Profile?  @relation("GiftCardRedeemer", fields: [redeemedById], references: [id])

  @@index([code])
  @@index([isActive])
  @@index([expiresAt])
  @@map("gift_cards")
}

model SubscriptionPlan {
  id              String         @id @default(uuid()) @db.Uuid
  name            String         @db.VarChar(200)
  slug            String         @unique @db.VarChar(200)
  description     String?
  price           Decimal        @db.Decimal(10, 2)
  currency        String         @default("INR") @db.VarChar(3)
  interval        String         @default("monthly") @db.VarChar(50)
  trialPeriodDays Int            @default(0) @map("trial_period_days")
  features        Json?
  isActive        Boolean        @default(true) @map("is_active")
  sortOrder       Int            @default(0) @map("sort_order")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  subscriptions   Subscription[]

  @@index([isActive])
  @@index([slug])
  @@map("subscription_plans")
}

model Subscription {
  id                     String                @id @default(uuid()) @db.Uuid
  profileId              String                @map("profile_id") @db.Uuid
  planId                 String                @map("plan_id") @db.Uuid
  status                 String                @default("active") @db.VarChar(50)
  currentPeriodStart     DateTime?             @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd       DateTime?             @map("current_period_end") @db.Timestamptz(6)
  trialEndsAt            DateTime?             @map("trial_ends_at") @db.Timestamptz(6)
  cancelledAt            DateTime?             @map("cancelled_at") @db.Timestamptz(6)
  razorpaySubscriptionId String?               @map("razorpay_subscription_id") @db.VarChar(100)
  razorpayPlanId         String?               @map("razorpay_plan_id") @db.VarChar(100)
  paymentMethod          String?               @map("payment_method") @db.VarChar(50)
  nextBillingAt          DateTime?             @map("next_billing_at") @db.Timestamptz(6)
  lastPaymentAt          DateTime?             @map("last_payment_at") @db.Timestamptz(6)
  createdAt              DateTime              @default(now()) @map("created_at")
  updatedAt              DateTime              @updatedAt @map("updated_at")
  invoices               SubscriptionInvoice[]
  plan                   SubscriptionPlan      @relation(fields: [planId], references: [id])
  profile                Profile               @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, planId])
  @@index([status])
  @@index([nextBillingAt])
  @@map("subscriptions")
}

model SubscriptionInvoice {
  id                String       @id @default(uuid()) @db.Uuid
  subscriptionId    String       @map("subscription_id") @db.Uuid
  amount            Decimal      @db.Decimal(10, 2)
  currency          String       @default("INR") @db.VarChar(3)
  status            String       @default("pending") @db.VarChar(50)
  razorpayInvoiceId String?      @map("razorpay_invoice_id") @db.VarChar(100)
  razorpayPaymentId String?      @map("razorpay_payment_id") @db.VarChar(100)
  periodStart       DateTime?    @map("period_start") @db.Timestamptz(6)
  periodEnd         DateTime?    @map("period_end") @db.Timestamptz(6)
  paidAt            DateTime?    @map("paid_at") @db.Timestamptz(6)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  subscription      Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([status])
  @@map("subscription_invoices")
}

model Currency {
  code             String   @id @db.VarChar(3)
  name             String   @db.VarChar(100)
  symbol           String   @db.VarChar(10)
  exchangeRate     Decimal  @default(1) @map("exchange_rate") @db.Decimal(12, 6)
  isBase           Boolean  @default(false) @map("is_base")
  isActive         Boolean  @default(false) @map("is_active")
  decimalPlaces    Int      @default(2) @map("decimal_places")
  formattingLocale String   @default("en-IN") @map("formatting_locale") @db.VarChar(10)
  updatedAt        DateTime @updatedAt @map("updated_at")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([isActive])
  @@map("currencies")
}

