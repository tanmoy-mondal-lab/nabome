generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres", "postgresqlExtensions"]
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "foreignKeys"
  extensions   = [pg_trgm, pgcrypto]
}

model Addresses {
  @@map("addresses")
  id                                           String   @id @db.Uuid
  profileId                                   String   @map("profile_id") @db.Uuid
  label                                        String   @default("Home") @db.VarChar(50)
  fullName                                    String   @map("full_name") @db.VarChar(200)
  phone                                        String   @db.VarChar(20)
  line1                                        String   @db.VarChar(500)
  line2                                        String?  @db.VarChar(500)
  city                                         String   @db.VarChar(200)
  state                                        String   @db.VarChar(200)
  pincode                                      String   @db.VarChar(10)
  country                                      String   @default("India") @db.VarChar(100)
  isDefault                                   Boolean  @map("is_default") @default(false)
  createdAt                                   DateTime @map("created_at") @default(now())
  updatedAt                                   DateTime @map("updated_at")
  isBillingDefault                           Boolean  @map("is_billing_default") @default(false)
  addressType                                 String   @map("address_type") @default("shipping") @db.VarChar(20)
  district                                     String?  @db.VarChar(200)
  profiles                                     Profiles @relation(fields: [profileId], references: [id], onDelete: Cascade)
  orders_orders_billing_address_idToaddresses  Orders[] @relation("orders_billing_address_idToaddresses")
  orders_orders_shipping_address_idToaddresses Orders[] @relation("orders_shipping_address_idToaddresses")

  @@index([pincode])
  @@index([profileId])
}

model AnalyticsEvents {
  @@map("analytics_events")
  eventType String   @map("event_type") @db.VarChar(100)
  profileId String?  @map("profile_id") @db.Uuid
  sessionId String?  @map("session_id") @db.VarChar(100)
  payload    Json?
  pageUrl   String? @map("page_url")
  userAgent String? @map("user_agent")
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  createdAt DateTime @map("created_at") @default(now())
  id         String   @id @db.Uuid

  @@index([createdAt])
  @@index([eventType, createdAt])
  @@index([profileId])
  @@index([sessionId])
}

model AnnouncementBars {
  @@map("announcement_bars")
  id         String                  @id @db.Uuid
  text       String
  linkUrl   String? @map("link_url")
  linkText  String?                 @map("link_text") @db.VarChar(100)
  bgColor   String?                 @map("bg_color") @db.VarChar(7)
  textColor String?                 @map("text_color") @db.VarChar(7)
  position   AnnouncementBarPosition @default(top)
  isActive  Boolean                 @map("is_active") @default(true)
  startDate DateTime?               @map("start_date") @db.Timestamptz(6)
  endDate   DateTime?               @map("end_date") @db.Timestamptz(6)
  createdAt DateTime                @map("created_at") @default(now())
  updatedAt DateTime @map("updated_at")

  @@index([isActive, position])
}

model ApiKeys {
  @@map("api_keys")
  id            String    @id @db.Uuid
  name          String    @db.VarChar(200)
  key           String    @db.VarChar(255)
  version       Int       @default(1)
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(6)
  isDeprecated Boolean   @map("is_deprecated") @default(false)
  deprecatedAt DateTime? @map("deprecated_at") @db.Timestamptz(6)
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(6)
  createdAt    DateTime  @map("created_at") @default(now())
  updatedAt    DateTime @map("updated_at")

  @@index([createdAt])
  @@index([expiresAt])
  @@index([isDeprecated])
}

model AuthSessions {
  @@map("auth_sessions")
  id                       String          @id @db.Uuid
  profileId               String          @map("profile_id") @db.Uuid
  accessToken             String          @map("access_token") @unique
  refreshToken            String          @map("refresh_token") @unique
  refreshTokenExpiresAt DateTime?       @map("refresh_token_expires_at") @db.Timestamptz(6)
  userAgent               String? @map("user_agent")
  ipAddress               String?         @map("ip_address") @db.VarChar(45)
  deviceName              String?         @map("device_name") @db.VarChar(200)
  isActive                Boolean         @map("is_active") @default(true)
  revokedAt               DateTime?       @map("revoked_at") @db.Timestamptz(6)
  rotatedFromSessionId  String?         @map("rotated_from_session_id") @db.Uuid
  lastActiveAt           DateTime        @map("last_active_at") @default(now()) @db.Timestamptz(6)
  expiresAt               DateTime        @map("expires_at") @db.Timestamptz(6)
  createdAt               DateTime        @map("created_at") @default(now())
  profiles                 Profiles        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  authSessions            AuthSessions?  @relation("auth_sessionsToauth_sessions", fields: [rotatedFromSessionId], references: [id])
  otherAuthSessions      AuthSessions[] @relation("auth_sessionsToauth_sessions")

  @@index([expiresAt])
  @@index([profileId, isActive])
  @@index([refreshTokenExpiresAt])
  @@index([rotatedFromSessionId])
}

model Brands {
  @@map("brands")
  id             String     @id @db.Uuid
  name           String     @db.VarChar(200)
  slug           String     @unique @db.VarChar(200)
  description    String?
  logoUrl       String? @map("logo_url")
  websiteUrl    String? @map("website_url")
  sortOrder     Int        @map("sort_order") @default(0)
  isActive      Boolean    @map("is_active") @default(true)
  createdAt     DateTime   @map("created_at") @default(now())
  updatedAt     DateTime @map("updated_at")
  logoPublicId String?    @map("logo_public_id") @db.VarChar(500)
  products       Products[]

  @@index([isActive])
}

model Campaigns {
  @@map("campaigns")
  id          String       @id @db.Uuid
  name        String       @db.VarChar(200)
  description String?
  type        CampaignType
  startDate  DateTime     @map("start_date") @db.Timestamptz(6)
  endDate    DateTime?    @map("end_date") @db.Timestamptz(6)
  isActive   Boolean      @map("is_active") @default(true)
  metadata    Json?
  createdAt  DateTime     @map("created_at") @default(now())
  updatedAt  DateTime @map("updated_at")

  @@index([startDate, endDate])
  @@index([type, isActive])
}

model CartItems {
  @@map("cart_items")
  id               String           @id @db.Uuid
  cartId          String           @map("cart_id") @db.Uuid
  variantId       String           @map("variant_id") @db.Uuid
  quantity         Int              @default(1)
  savedForLater  Boolean          @map("saved_for_later") @default(false)
  createdAt       DateTime         @map("created_at") @default(now())
  updatedAt       DateTime @map("updated_at")
  carts            Carts            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productVariants ProductVariants @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
}

model Carts {
  @@map("carts")
  id         String       @id @db.Uuid
  profileId String       @map("profile_id") @unique @db.Uuid
  createdAt DateTime     @map("created_at") @default(now())
  updatedAt DateTime @map("updated_at")
  expiresAt DateTime?    @map("expires_at") @db.Timestamptz(6)
  cartItems CartItems[] @map("cart_items")
  profiles   Profiles     @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model Categories {
  @@map("categories")
  id               String          @id @db.Uuid
  name             String          @db.VarChar(200)
  slug             String          @unique @db.VarChar(200)
  description      String?
  imageUrl        String? @map("image_url")
  parentId        String?         @map("parent_id") @db.Uuid
  sortOrder       Int             @map("sort_order") @default(0)
  isActive        Boolean         @map("is_active") @default(true)
  metaTitle       String?         @map("meta_title") @db.VarChar(200)
  metaDesc        String? @map("meta_desc")
  createdAt       DateTime        @map("created_at") @default(now())
  updatedAt       DateTime @map("updated_at")
  imagePublicId  String?         @map("image_public_id") @db.VarChar(500)
  categories       Categories?     @relation("categoriesTocategories", fields: [parentId], references: [id])
  otherCategories Categories[]    @relation("categoriesTocategories")
  products         Products[]
  sizeGuides      SizeGuides[] @map("size_guides")
  subcategories    Subcategories[]

  @@index([isActive])
  @@index([parentId])
  @@index([sortOrder])
}

model Collections {
  @@map("collections")
  id                   String     @id @db.Uuid
  name                 String     @db.VarChar(200)
  slug                 String     @unique @db.VarChar(200)
  description          String?
  heroImageUrl       String? @map("hero_image_url")
  isActive            Boolean    @map("is_active") @default(true)
  isFeatured          Boolean    @map("is_featured") @default(false)
  startDate           DateTime?  @map("start_date") @db.Timestamptz(6)
  endDate             DateTime?  @map("end_date") @db.Timestamptz(6)
  sortOrder           Int        @map("sort_order") @default(0)
  metaTitle           String?    @map("meta_title") @db.VarChar(200)
  metaDesc            String? @map("meta_desc")
  createdAt           DateTime   @map("created_at") @default(now())
  updatedAt           DateTime @map("updated_at")
  heroImagePublicId String?    @map("hero_image_public_id") @db.VarChar(500)
  products             Products[]

  @@index([isFeatured])
  @@index([sortOrder])
}

model ContactSubmissions {
  @@map("contact_submissions")
  id         String   @id @db.Uuid
  name       String   @db.VarChar(200)
  email      String   @db.VarChar(255)
  phone      String?  @db.VarChar(20)
  subject    String?  @db.VarChar(500)
  message    String
  isRead    Boolean  @map("is_read") @default(false)
  createdAt DateTime @map("created_at") @default(now())

  @@index([createdAt])
  @@index([isRead])
}

model CouponRedemptions {
  @@map("coupon_redemptions")
  id         String   @id @db.Uuid
  couponId  String   @map("coupon_id") @db.Uuid
  orderId   String   @map("order_id") @unique @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  createdAt DateTime @map("created_at") @default(now())
  coupons    Coupons  @relation(fields: [couponId], references: [id])
  orders     Orders   @relation(fields: [orderId], references: [id])
  profiles   Profiles @relation(fields: [profileId], references: [id])

  @@unique([couponId, profileId, orderId])
  @@index([couponId])
  @@index([couponId, profileId])
  @@index([profileId])
}

model Coupons {
  @@map("coupons")
  id                 String               @id @db.Uuid
  code               String               @unique @db.VarChar(50)
  description        String?
  discountType      DiscountType @map("discount_type")
  discountValue     Decimal              @map("discount_value") @db.Decimal(10, 2)
  minOrderValue    Decimal?             @map("min_order_value") @db.Decimal(10, 2)
  maxDiscount       Decimal?             @map("max_discount") @db.Decimal(10, 2)
  usageLimit        Int? @map("usage_limit")
  usedCount         Int                  @map("used_count") @default(0)
  perUserLimit     Int                  @map("per_user_limit") @default(1)
  applicableGender  Gender? @map("applicable_gender")
  isActive          Boolean              @map("is_active") @default(true)
  startDate         DateTime             @map("start_date") @db.Timestamptz(6)
  endDate           DateTime             @map("end_date") @db.Timestamptz(6)
  createdAt         DateTime             @map("created_at") @default(now())
  updatedAt         DateTime @map("updated_at")
  couponRedemptions CouponRedemptions[] @map("coupon_redemptions")

  @@index([isActive, startDate, endDate])
}

model Currencies {
  @@map("currencies")
  code              String   @id @db.VarChar(3)
  name              String   @db.VarChar(100)
  symbol            String   @db.VarChar(10)
  exchangeRate     Decimal  @map("exchange_rate") @default(1) @db.Decimal(12, 6)
  isBase           Boolean  @map("is_base") @default(false)
  isActive         Boolean  @map("is_active") @default(false)
  decimalPlaces    Int      @map("decimal_places") @default(2)
  formattingLocale String   @map("formatting_locale") @default("en-IN") @db.VarChar(10)
  updatedAt        DateTime @map("updated_at")
  createdAt        DateTime @map("created_at") @default(now())

  @@index([isActive])
}

model DeadLetterQueue {
  @@map("dead_letter_queue")
  id              String   @id @db.Uuid
  jobType        String   @map("job_type") @db.VarChar(100)
  payload         Json
  errorMessage   String @map("error_message")
  retryCount     Int @map("retry_count")
  originalJobId String?  @map("original_job_id") @db.Uuid
  createdAt      DateTime @map("created_at") @default(now()) @db.Timestamptz(6)

  @@index([jobType, createdAt])
}

model Faqs {
  @@map("faqs")
  id         String   @id @db.Uuid
  question   String
  answer     String
  category   String?  @db.VarChar(100)
  sortOrder Int      @map("sort_order") @default(0)
  isActive  Boolean  @map("is_active") @default(true)
  createdAt DateTime @map("created_at") @default(now())
  updatedAt DateTime @map("updated_at")

  @@index([category, isActive])
  @@index([sortOrder])
}

model FooterSections {
  @@map("footer_sections")
  id           String   @id @db.Uuid
  column       Int      @default(1)
  title        String   @db.VarChar(200)
  contentType String   @map("content_type") @default("links") @db.VarChar(50)
  content      Json?
  sortOrder   Int      @map("sort_order") @default(0)
  isActive    Boolean  @map("is_active") @default(true)
  createdAt   DateTime @map("created_at") @default(now())
  updatedAt   DateTime @map("updated_at")

  @@index([column, sortOrder])
}

model GiftCards {
  @@map("gift_cards")
  id                                            String    @id @db.Uuid
  code                                          String    @unique @db.VarChar(50)
  initialBalance                               Decimal   @map("initial_balance") @db.Decimal(10, 2)
  currentBalance                               Decimal   @map("current_balance") @db.Decimal(10, 2)
  currency                                      String    @default("INR") @db.VarChar(3)
  senderName                                   String?   @map("sender_name") @db.VarChar(200)
  senderEmail                                  String?   @map("sender_email") @db.VarChar(255)
  recipientName                                String?   @map("recipient_name") @db.VarChar(200)
  recipientEmail                               String?   @map("recipient_email") @db.VarChar(255)
  message                                       String?
  purchasedById                               String?   @map("purchased_by_id") @db.Uuid
  redeemedById                                String?   @map("redeemed_by_id") @db.Uuid
  orderId                                      String?   @map("order_id") @db.Uuid
  isActive                                     Boolean   @map("is_active") @default(true)
  expiresAt                                    DateTime? @map("expires_at") @db.Timestamptz(6)
  redeemedAt                                   DateTime? @map("redeemed_at") @db.Timestamptz(6)
  createdAt                                    DateTime  @map("created_at") @default(now())
  updatedAt                                    DateTime @map("updated_at")
  orders                                        Orders?   @relation(fields: [orderId], references: [id])
  profiles_gift_cards_purchased_by_idToprofiles Profiles? @relation("gift_cards_purchased_by_idToprofiles", fields: [purchasedById], references: [id])
  profiles_gift_cards_redeemed_by_idToprofiles  Profiles? @relation("gift_cards_redeemed_by_idToprofiles", fields: [redeemedById], references: [id])

  @@index([code])
  @@index([expiresAt])
  @@index([isActive])
}

model HomepageSections {
  @@map("homepage_sections")
  id           String      @id @db.Uuid
  sectionType SectionType @map("section_type")
  title        String?     @db.VarChar(200)
  subtitle     String?     @db.VarChar(500)
  content      Json?
  sortOrder   Int         @map("sort_order") @default(0)
  isActive    Boolean     @map("is_active") @default(true)
  visibility   Visibility  @default(all)
  createdAt   DateTime    @map("created_at") @default(now())
  updatedAt   DateTime @map("updated_at")
  expireAt    DateTime?   @map("expire_at") @db.Timestamptz(6)
  publishAt   DateTime?   @map("publish_at") @db.Timestamptz(6)
  styles       Json?

  @@index([isActive, sortOrder])
  @@index([publishAt, expireAt])
}

model InventoryAlerts {
  @@map("inventory_alerts")
  id               String           @id @db.Uuid
  variantId       String           @map("variant_id") @db.Uuid
  type             String           @db.VarChar(50)
  message          String
  threshold        Int?             @db.SmallInt
  currentStock    Int              @map("current_stock") @db.SmallInt
  isResolved      Boolean          @map("is_resolved") @default(false)
  resolvedAt      DateTime?        @map("resolved_at") @db.Timestamptz(6)
  createdAt       DateTime         @map("created_at") @default(now())
  productVariants ProductVariants @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([type, isResolved])
  @@index([variantId, isResolved])
}

model InventoryMovements {
  @@map("inventory_movements")
  id               String           @id @db.Uuid
  variantId       String           @map("variant_id") @db.Uuid
  quantityChange  Int @map("quantity_change")
  stockAfter      Int @map("stock_after")
  reason           String           @db.VarChar(200)
  referenceId     String?          @map("reference_id") @db.VarChar(100)
  note             String?
  createdAt       DateTime         @map("created_at") @default(now())
  productVariants ProductVariants @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([reason])
  @@index([variantId])
}

model JobQueue {
  @@map("job_queue")
  id            String    @id @db.Uuid
  jobType      String    @map("job_type") @db.VarChar(100)
  payload       Json
  priority      Int       @default(0)
  maxRetries   Int       @map("max_retries") @default(3)
  retryCount   Int       @map("retry_count") @default(0)
  retryAfter   DateTime? @map("retry_after") @db.Timestamptz(6)
  errorMessage String? @map("error_message")
  startedAt    DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt    DateTime  @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @map("updated_at") @db.Timestamptz(6)
  status        JobStatus @default(pending)

  @@index([jobType])
  @@index([status, priority, createdAt])
  @@index([status, retryAfter])
}

model LoginAttempts {
  @@map("login_attempts")
  id          String    @id @db.Uuid
  profileId  String?   @map("profile_id") @db.Uuid
  email       String    @db.VarChar(255)
  ipAddress  String    @map("ip_address") @db.VarChar(45)
  userAgent  String? @map("user_agent")
  success     Boolean   @default(false)
  failReason String?   @map("fail_reason") @db.VarChar(100)
  createdAt  DateTime  @map("created_at") @default(now())
  profiles    Profiles? @relation(fields: [profileId], references: [id])

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@index([profileId])
}

model LookbookItems {
  @@map("lookbook_items")
  id              String    @id @db.Uuid
  lookbookId     String    @map("lookbook_id") @db.Uuid
  imageUrl       String @map("image_url")
  productId      String?   @map("product_id") @db.Uuid
  hotspotX       Decimal?  @map("hotspot_x") @db.Decimal(5, 3)
  hotspotY       Decimal?  @map("hotspot_y") @db.Decimal(5, 3)
  caption         String?   @db.VarChar(500)
  sortOrder      Int       @map("sort_order") @default(0)
  imagePublicId String?   @map("image_public_id") @db.VarChar(500)
  lookbooks       Lookbooks @relation(fields: [lookbookId], references: [id], onDelete: Cascade)
  products        Products? @relation(fields: [productId], references: [id])

  @@index([lookbookId])
  @@index([productId])
}

model Lookbooks {
  @@map("lookbooks")
  id                    String           @id @db.Uuid
  name                  String           @db.VarChar(200)
  slug                  String           @unique @db.VarChar(200)
  description           String?
  coverImageUrl       String @map("cover_image_url")
  season                String?          @db.VarChar(50)
  year                  Int?
  layout                String           @default("grid") @db.VarChar(50)
  story                 Json?
  tags                  String[]         @default([])
  metaTitle            String?          @map("meta_title") @db.VarChar(200)
  metaDesc             String? @map("meta_desc")
  isActive             Boolean          @map("is_active") @default(true)
  sortOrder            Int              @map("sort_order") @default(0)
  publishedAt          DateTime?        @map("published_at") @db.Timestamptz(6)
  createdAt            DateTime         @map("created_at") @default(now())
  updatedAt            DateTime @map("updated_at")
  coverImagePublicId String?          @map("cover_image_public_id") @db.VarChar(500)
  lookbookItems        LookbookItems[] @map("lookbook_items")

  @@index([isActive, sortOrder])
  @@index([season, year])
}

model LoyaltyPoints {
  @@map("loyalty_points")
  id                   String                 @id @db.Uuid
  profileId           String                 @map("profile_id") @unique @db.Uuid
  points               Int                    @default(0)
  tier                 String                 @default("bronze") @db.VarChar(50)
  lifetimePoints      Int                    @map("lifetime_points") @default(0)
  createdAt           DateTime               @map("created_at") @default(now())
  updatedAt           DateTime @map("updated_at")
  profiles             Profiles               @relation(fields: [profileId], references: [id], onDelete: Cascade)
  loyaltyTransactions LoyaltyTransactions[] @map("loyalty_transactions")

  @@index([tier])
}

model LoyaltyTiers {
  @@map("loyalty_tiers")
  id                String   @id @db.Uuid
  name              String   @unique @db.VarChar(50)
  minPoints        Int      @map("min_points") @default(0)
  discountPercent  Int      @map("discount_percent") @default(0)
  freeShipping     Boolean  @map("free_shipping") @default(false)
  pointsMultiplier Decimal  @map("points_multiplier") @default(1) @db.Decimal(3, 1)
  badgeColor       String?  @map("badge_color") @db.VarChar(7)
  description       String?
  isActive         Boolean  @map("is_active") @default(true)
  createdAt        DateTime @map("created_at") @default(now())
  updatedAt        DateTime @map("updated_at")

  @@index([isActive])
}

model LoyaltyTransactions {
  @@map("loyalty_transactions")
  id                String         @id @db.Uuid
  loyaltyPointsId String         @map("loyalty_points_id") @db.Uuid
  points            Int
  type              String         @db.VarChar(50)
  description       String?        @db.VarChar(500)
  referenceId      String?        @map("reference_id") @db.VarChar(100)
  referenceType    String?        @map("reference_type") @db.VarChar(50)
  expiresAt        DateTime?      @map("expires_at") @db.Timestamptz(6)
  createdAt        DateTime       @map("created_at") @default(now())
  loyaltyPoints    LoyaltyPoints @relation(fields: [loyaltyPointsId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([loyaltyPointsId])
  @@index([type])
}

model MediaAssets {
  @@map("media_assets")
  id                String       @id @db.Uuid
  url               String       @db.VarChar(1000)
  altText          String?      @map("alt_text") @db.VarChar(500)
  width             Int?
  height            Int?
  fileSize         Int? @map("file_size")
  mimeType         String?      @map("mime_type") @db.VarChar(100)
  tags              String[]     @default([])
  folder            String?      @db.VarChar(500)
  createdAt        DateTime     @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime     @map("updated_at") @db.Timestamptz(6)
  assetId          String       @map("asset_id") @unique @db.VarChar(100)
  caption           String?      @db.VarChar(1000)
  displayName      String?      @map("display_name") @db.VarChar(255)
  duration          Int?
  entityId         String       @map("entity_id") @db.Uuid
  entityType       EntityType @map("entity_type")
  fileExtension    String?      @map("file_extension") @db.VarChar(20)
  isPrimary        Boolean      @map("is_primary") @default(false)
  mediaType        MediaType    @map("media_type") @default(image)
  metadata          Json?
  originalFilename String?      @map("original_filename") @db.VarChar(255)
  publicId         String?      @map("public_id") @db.VarChar(500)
  resourceType     ResourceType @map("resource_type") @default(image)
  secureUrl        String?      @map("secure_url") @db.VarChar(1000)
  sortOrder        Int          @map("sort_order") @default(0)

  @@index([assetId])
  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([entityType, entityId, isPrimary])
  @@index([entityType, folder])
  @@index([folder])
  @@index([isPrimary])
  @@index([mediaType])
  @@index([resourceType])
}

model NavigationMenus {
  @@map("navigation_menus")
  id         String       @id @db.Uuid
  name       String       @db.VarChar(200)
  location   MenuLocation
  items      Json
  isActive  Boolean      @map("is_active") @default(true)
  createdAt DateTime     @map("created_at") @default(now())
  updatedAt DateTime @map("updated_at")

  @@unique([name, location])
  @@index([location, isActive])
}

model NewsletterSubscribers {
  @@map("newsletter_subscribers")
  id         String   @id @db.Uuid
  email      String   @unique @db.VarChar(255)
  isActive  Boolean  @map("is_active") @default(true)
  createdAt DateTime @map("created_at") @default(now())

  @@index([isActive])
}

model NotificationTemplates {
  @@map("notification_templates")
  id          String            @id @db.Uuid
  event       NotificationEvent @unique
  subject     String            @db.VarChar(500)
  emailBody  String? @map("email_body")
  smsBody    String?           @map("sms_body") @db.VarChar(500)
  inAppBody String?           @map("in_app_body") @db.VarChar(500)
  isActive   Boolean           @map("is_active") @default(true)
  createdAt  DateTime          @map("created_at") @default(now())
  updatedAt  DateTime @map("updated_at")
}

model Notifications {
  @@map("notifications")
  id            String              @id @db.Uuid
  profileId    String?             @map("profile_id") @db.Uuid
  orderId      String?             @map("order_id") @db.Uuid
  type          NotificationEvent
  channel       NotificationChannel @default(in_app)
  title         String              @db.VarChar(500)
  body          String?
  data          Json?
  isRead       Boolean             @map("is_read") @default(false)
  readAt       DateTime?           @map("read_at") @db.Timestamptz(6)
  sentAt       DateTime?           @map("sent_at") @db.Timestamptz(6)
  emailTo      String?             @map("email_to") @db.VarChar(255)
  errorMessage String? @map("error_message")
  retryCount   Int                 @map("retry_count") @default(0)
  createdAt    DateTime            @map("created_at") @default(now())
  updatedAt    DateTime @map("updated_at")
  orders        Orders?             @relation(fields: [orderId], references: [id])
  profiles      Profiles?           @relation(fields: [profileId], references: [id])

  @@index([channel, sentAt])
  @@index([orderId])
  @@index([profileId, createdAt])
  @@index([profileId, isRead])
}

model OrderItems {
  @@map("order_items")
  id               String            @id @db.Uuid
  orderId         String            @map("order_id") @db.Uuid
  productId       String            @map("product_id") @db.Uuid
  variantId       String?           @map("variant_id") @db.Uuid
  productName     String            @map("product_name") @db.VarChar(300)
  variantLabel    String            @map("variant_label") @db.VarChar(200)
  sku              String            @db.VarChar(100)
  quantity         Int
  unitPrice       Decimal           @map("unit_price") @db.Decimal(10, 2)
  totalPrice      Decimal           @map("total_price") @db.Decimal(10, 2)
  imageUrl        String? @map("image_url")
  isReturned      Boolean           @map("is_returned") @default(false)
  returnQuantity  Int               @map("return_quantity") @default(0)
  orders           Orders            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  products         Products          @relation(fields: [productId], references: [id])
  productVariants ProductVariants? @relation(fields: [variantId], references: [id])
  returnRequests  ReturnRequests[] @map("return_requests")

  @@index([orderId])
  @@index([orderId, isReturned])
  @@index([orderId, productId])
  @@index([productId])
  @@index([productId, variantId])
  @@index([variantId])
}

model OrderStatusHistory {
  @@map("order_status_history")
  id         String      @id @db.Uuid
  orderId   String      @map("order_id") @db.Uuid
  status     OrderStatus
  note       String?
  createdBy String?     @map("created_by") @db.Uuid
  createdAt DateTime    @map("created_at") @default(now())
  profiles   Profiles?   @relation(fields: [createdBy], references: [id])
  orders     Orders      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([createdBy])
  @@index([orderId])
}

model Orders {
  @@map("orders")
  id                                              String                 @id @db.Uuid
  orderNumber                                    String                 @map("order_number") @unique @db.VarChar(50)
  profileId                                      String?                @map("profile_id") @db.Uuid
  email                                           String                 @db.VarChar(255)
  status                                          OrderStatus            @default(pending)
  subtotal                                        Decimal                @db.Decimal(10, 2)
  shippingCost                                   Decimal                @map("shipping_cost") @default(0) @db.Decimal(10, 2)
  tax                                             Decimal                @default(0) @db.Decimal(10, 2)
  discount                                        Decimal                @default(0) @db.Decimal(10, 2)
  couponCode                                     String?                @map("coupon_code") @db.VarChar(50)
  total                                           Decimal                @db.Decimal(10, 2)
  currency                                        String                 @default("INR") @db.VarChar(3)
  paymentMethod                                  String                 @map("payment_method") @db.VarChar(50)
  paymentStatus                                  PaymentStatus          @map("payment_status") @default(pending)
  razorpayOrderId                               String?                @map("razorpay_order_id") @db.VarChar(100)
  razorpayPaymentId                             String?                @map("razorpay_payment_id") @db.VarChar(100)
  shippingAddressId                             String?                @map("shipping_address_id") @db.Uuid
  billingAddressId                              String?                @map("billing_address_id") @db.Uuid
  giftMessage                                    String? @map("gift_message")
  notes                                           String?
  shippedAt                                      DateTime?              @map("shipped_at") @db.Timestamptz(6)
  deliveredAt                                    DateTime?              @map("delivered_at") @db.Timestamptz(6)
  cancelledAt                                    DateTime?              @map("cancelled_at") @db.Timestamptz(6)
  cancellationReason                             String?                @map("cancellation_reason") @db.VarChar(500)
  refundedAt                                     DateTime?              @map("refunded_at") @db.Timestamptz(6)
  createdAt                                      DateTime               @map("created_at") @default(now())
  updatedAt                                      DateTime @map("updated_at")
  internalNotes                                  String? @map("internal_notes")
  invoiceUrl                                     String? @map("invoice_url")
  returnRequestedAt                             DateTime?              @map("return_requested_at") @db.Timestamptz(6)
  trackingNumber                                 String?                @map("tracking_number") @db.VarChar(200)
  carrier                                         String?                @db.VarChar(100)
  trackingUrl                                    String? @map("tracking_url")
  couponRedemptions                              CouponRedemptions? @map("coupon_redemptions")
  giftCards                                      GiftCards[] @map("gift_cards")
  notifications                                   Notifications[]
  orderItems                                     OrderItems[] @map("order_items")
  orderStatusHistory                            OrderStatusHistory[] @map("order_status_history")
  addresses_orders_billing_address_idToaddresses  Addresses?             @relation("orders_billing_address_idToaddresses", fields: [billingAddressId], references: [id])
  profiles                                        Profiles?              @relation(fields: [profileId], references: [id])
  addresses_orders_shipping_address_idToaddresses Addresses?             @relation("orders_shipping_address_idToaddresses", fields: [shippingAddressId], references: [id])
  referrals                                       Referrals[]
  refunds                                         Refunds[]
  returnRequests                                 ReturnRequests[] @map("return_requests")
  supportTickets                                 SupportTickets[] @map("support_tickets")
  webhookEvents                                  WebhookEvents[] @map("webhook_events")

  @@index([billingAddressId])
  @@index([createdAt])
  @@index([email])
  @@index([paymentStatus, createdAt])
  @@index([profileId, createdAt])
  @@index([profileId])
  @@index([profileId, status, createdAt])
  @@index([profileId, status])
  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
  @@index([shippingAddressId])
  @@index([status, createdAt])
  @@index([status, paymentStatus])
}

model PageTemplates {
  @@map("page_templates")
  id                  String   @id @db.Uuid
  name                String   @db.VarChar(200)
  slug                String   @unique @db.VarChar(200)
  description         String?
  category            String   @default("custom") @db.VarChar(50)
  thumbnail           String?
  sections            Json
  metadata            Json?
  isActive           Boolean  @map("is_active") @default(true)
  useCount           Int      @map("use_count") @default(0)
  createdAt          DateTime @map("created_at") @default(now())
  updatedAt          DateTime @map("updated_at")
  thumbnailPublicId String?  @map("thumbnail_public_id") @db.VarChar(500)

  @@index([category, isActive])
}

model ProductAttributes {
  @@map("product_attributes")
  id         String   @id @db.Uuid
  productId String   @map("product_id") @db.Uuid
  name       String   @db.VarChar(100)
  value      String   @db.VarChar(200)
  products   Products @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([name])
  @@index([productId])
}

model ProductImages {
  @@map("product_images")
  id               String            @id @db.Uuid
  productId       String            @map("product_id") @db.Uuid
  variantId       String?           @map("variant_id") @db.Uuid
  url              String
  altText         String?           @map("alt_text") @db.VarChar(500)
  sortOrder       Int               @map("sort_order") @default(0)
  isPrimary       Boolean           @map("is_primary") @default(false)
  type             String?           @default("image") @db.VarChar(20)
  publicId        String?           @map("public_id") @db.VarChar(500)
  products         Products          @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariants ProductVariants? @relation(fields: [variantId], references: [id])

  @@index([isPrimary])
  @@index([productId])
  @@index([variantId])
}

model ProductLabels {
  @@map("product_labels")
  id                      String                    @id @db.Uuid
  name                    String                    @db.VarChar(100)
  slug                    String                    @unique @db.VarChar(200)
  color                   String?                   @db.VarChar(7)
  createdAt              DateTime                  @map("created_at") @default(now())
  productLabelsProducts ProductLabelsProducts[] @map("product_labels_products")
}

model ProductLabelsProducts {
  @@map("product_labels_products")
  productId     String         @map("product_id") @db.Uuid
  labelId       String         @map("label_id") @db.Uuid
  productLabels ProductLabels @relation(fields: [labelId], references: [id], onDelete: Cascade)
  products       Products       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, labelId])
  @@index([labelId])
}

model ProductTags {
  @@map("product_tags")
  id                    String                  @id @db.Uuid
  name                  String                  @unique @db.VarChar(100)
  slug                  String                  @unique @db.VarChar(200)
  createdAt            DateTime                @map("created_at") @default(now())
  productTagsProducts ProductTagsProducts[] @map("product_tags_products")
}

model ProductTagsProducts {
  @@map("product_tags_products")
  productId   String       @map("product_id") @db.Uuid
  tagId       String       @map("tag_id") @db.Uuid
  products     Products     @relation(fields: [productId], references: [id], onDelete: Cascade)
  productTags ProductTags @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}

model ProductVariants {
  @@map("product_variants")
  id                  String                @id @db.Uuid
  productId          String                @map("product_id") @db.Uuid
  sku                 String                @unique @db.VarChar(100)
  size                String                @db.VarChar(50)
  color               String                @db.VarChar(100)
  colorHex           String?               @map("color_hex") @db.VarChar(7)
  priceAdjustment    Decimal               @map("price_adjustment") @default(0) @db.Decimal(10, 2)
  stock               Int                   @default(0)
  reservedStock      Int                   @map("reserved_stock") @default(0)
  weight              Decimal?              @db.Decimal(8, 2)
  isActive           Boolean               @map("is_active") @default(true)
  createdAt          DateTime              @map("created_at") @default(now())
  updatedAt          DateTime @map("updated_at")
  videoPublicId     String?               @map("video_public_id") @db.VarChar(500)
  videoUrl           String? @map("video_url")
  cartItems          CartItems[] @map("cart_items")
  inventoryAlerts    InventoryAlerts[] @map("inventory_alerts")
  inventoryMovements InventoryMovements[] @map("inventory_movements")
  orderItems         OrderItems[] @map("order_items")
  productImages      ProductImages[] @map("product_images")
  products            Products              @relation(fields: [productId], references: [id], onDelete: Cascade)
  wishlistItems      WishlistItems[] @map("wishlist_items")

  @@unique([productId, size, color])
  @@index([isActive, stock])
  @@index([productId])
  @@index([productId, isActive])
  @@index([size, color])
}

model Products {
  @@map("products")
  id                                                    String                    @id @db.Uuid
  name                                                  String                    @db.VarChar(300)
  slug                                                  String                    @unique @db.VarChar(300)
  description                                           String?
  shortDescription                                     String? @map("short_description")
  categoryId                                           String?                   @map("category_id") @db.Uuid
  subcategoryId                                        String?                   @map("subcategory_id") @db.Uuid
  collectionId                                         String?                   @map("collection_id") @db.Uuid
  brandId                                              String?                   @map("brand_id") @db.Uuid
  basePrice                                            Decimal                   @map("base_price") @db.Decimal(10, 2)
  compareAtPrice                                      Decimal?                  @map("compare_at_price") @db.Decimal(10, 2)
  costPrice                                            Decimal?                  @map("cost_price") @db.Decimal(10, 2)
  salePrice                                            Decimal?                  @map("sale_price") @db.Decimal(10, 2)
  discountPercent                                      Int?                      @map("discount_percent") @db.SmallInt
  currency                                              String                    @default("INR") @db.VarChar(3)
  material                                              String?                   @db.VarChar(200)
  careInstructions                                     String? @map("care_instructions")
  sizeChartUrl                                        String? @map("size_chart_url")
  sizeGuideId                                         String?                   @map("size_guide_id") @db.Uuid
  isActive                                             Boolean                   @map("is_active") @default(true)
  isFeatured                                           Boolean                   @map("is_featured") @default(false)
  isNew                                                Boolean                   @map("is_new") @default(false)
  gender                                                Gender                    @default(unisex)
  sortOrder                                            Int                       @map("sort_order") @default(0)
  publishedAt                                          DateTime?                 @map("published_at") @db.Timestamptz(6)
  scheduledPublishAt                                  DateTime?                 @map("scheduled_publish_at") @db.Timestamptz(6)
  scheduledArchiveAt                                  DateTime?                 @map("scheduled_archive_at") @db.Timestamptz(6)
  metaTitle                                            String?                   @map("meta_title") @db.VarChar(200)
  metaDesc                                             String? @map("meta_desc")
  createdAt                                            DateTime                  @map("created_at") @default(now())
  updatedAt                                            DateTime @map("updated_at")
  sizeChartPublicId                                  String?                   @map("size_chart_public_id") @db.VarChar(500)
  lookbookItems                                        LookbookItems[] @map("lookbook_items")
  orderItems                                           OrderItems[] @map("order_items")
  productAttributes                                    ProductAttributes[] @map("product_attributes")
  productImages                                        ProductImages[] @map("product_images")
  productLabelsProducts                               ProductLabelsProducts[] @map("product_labels_products")
  productTagsProducts                                 ProductTagsProducts[] @map("product_tags_products")
  productVariants                                      ProductVariants[] @map("product_variants")
  brands                                                Brands?                   @relation(fields: [brandId], references: [id])
  categories                                            Categories?               @relation(fields: [categoryId], references: [id])
  collections                                           Collections?              @relation(fields: [collectionId], references: [id])
  sizeGuides                                           SizeGuides?              @relation(fields: [sizeGuideId], references: [id])
  subcategories                                         Subcategories?            @relation(fields: [subcategoryId], references: [id])
  related_products_related_products_source_idToproducts RelatedProducts[]        @relation("related_products_source_idToproducts")
  related_products_related_products_target_idToproducts RelatedProducts[]        @relation("related_products_target_idToproducts")
  reviews                                               Reviews[]

  @@index([brandId])
  @@index([categoryId])
  @@index([collectionId])
  @@index([createdAt])
  @@index([isActive, basePrice])
  @@index([isActive, basePrice, sortOrder])
  @@index([isActive, brandId, sortOrder])
  @@index([isActive, categoryId, gender])
  @@index([isActive, categoryId, sortOrder])
  @@index([isActive, collectionId, publishedAt])
  @@index([isActive, collectionId, sortOrder])
  @@index([isActive, gender, createdAt])
  @@index([isActive, isFeatured])
  @@index([isActive, isNew])
  @@index([scheduledArchiveAt])
  @@index([scheduledPublishAt])
  @@index([subcategoryId])
}

model Profiles {
  @@map("profiles")
  id                                                    String                   @id @db.Uuid
  email                                                 String                   @unique @db.VarChar(255)
  firstName                                            String                   @map("first_name") @db.VarChar(100)
  lastName                                             String?                  @map("last_name") @db.VarChar(100)
  phone                                                 String?                  @db.VarChar(20)
  avatarUrl                                            String? @map("avatar_url")
  isActive                                             Boolean                  @map("is_active") @default(true)
  emailVerified                                        Boolean                  @map("email_verified") @default(false)
  lastLoginAt                                         DateTime?                @map("last_login_at") @db.Timestamptz(6)
  loginCount                                           Int                      @map("login_count") @default(0)
  preferences                                           Json?
  phoneVerified                                        Boolean                  @map("phone_verified") @default(false)
  marketingOptIn                                      Boolean                  @map("marketing_opt_in") @default(true)
  notificationPreferences                              Json? @map("notification_preferences")
  createdAt                                            DateTime                 @map("created_at") @default(now())
  updatedAt                                            DateTime @map("updated_at")
  verificationToken                                    String?                  @map("verification_token") @db.VarChar(255)
  verificationTokenExpiresAt                         DateTime?                @map("verification_token_expires_at") @db.Timestamptz(6)
  pendingEmail                                         String?                  @map("pending_email") @db.VarChar(255)
  pendingEmailToken                                   String?                  @map("pending_email_token") @db.VarChar(255)
  pendingEmailTokenExpiresAt                        DateTime?                @map("pending_email_token_expires_at") @db.Timestamptz(6)
  resetPasswordToken                                  String?                  @map("reset_password_token") @db.VarChar(255)
  resetPasswordTokenExpiresAt                       DateTime?                @map("reset_password_token_expires_at") @db.Timestamptz(6)
  role                                                  UserRole                 @default(customer)
  addresses                                             Addresses[]
  authSessions                                         AuthSessions[] @map("auth_sessions")
  carts                                                 Carts?
  couponRedemptions                                    CouponRedemptions[] @map("coupon_redemptions")
  gift_cards_gift_cards_purchased_by_idToprofiles       GiftCards[]             @relation("gift_cards_purchased_by_idToprofiles")
  gift_cards_gift_cards_redeemed_by_idToprofiles        GiftCards[]             @relation("gift_cards_redeemed_by_idToprofiles")
  loginAttempts                                        LoginAttempts[] @map("login_attempts")
  loyaltyPoints                                        LoyaltyPoints? @map("loyalty_points")
  notifications                                         Notifications[]
  orderStatusHistory                                  OrderStatusHistory[] @map("order_status_history")
  orders                                                Orders[]
  referralCodes                                        ReferralCodes? @map("referral_codes")
  referrals                                             Referrals[]
  refunds                                               Refunds[]
  returnRequests                                       ReturnRequests[] @map("return_requests")
  reviews                                               Reviews[]
  subscriptions                                         Subscriptions[]
  supportTicketReplies                                SupportTicketReplies[] @map("support_ticket_replies")
  support_tickets_support_tickets_assigned_toToprofiles SupportTickets[]        @relation("support_tickets_assigned_toToprofiles")
  support_tickets_support_tickets_profile_idToprofiles  SupportTickets[]        @relation("support_tickets_profile_idToprofiles")
  userActionLogs                                      UserActionLogs[] @map("user_action_logs")
  verificationAttempts                                 VerificationAttempts[] @map("verification_attempts")
  wishlistItems                                        WishlistItems[] @map("wishlist_items")

  @@index([createdAt])
  @@index([isActive])
  @@index([role])
}

model ReferralCodes {
  @@map("referral_codes")
  id              String      @id @db.Uuid
  profileId      String      @map("profile_id") @unique @db.Uuid
  code            String      @unique @db.VarChar(50)
  totalReferrals Int         @map("total_referrals") @default(0)
  totalRewards   Decimal     @map("total_rewards") @default(0) @db.Decimal(10, 2)
  isActive       Boolean     @map("is_active") @default(true)
  createdAt      DateTime    @map("created_at") @default(now())
  updatedAt      DateTime @map("updated_at")
  profiles        Profiles    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  referrals       Referrals[]

  @@index([code])
}

model Referrals {
  @@map("referrals")
  id                  String         @id @db.Uuid
  referrerCodeId    String         @map("referrer_code_id") @db.Uuid
  referredEmail      String         @map("referred_email") @db.VarChar(255)
  referredProfileId String?        @map("referred_profile_id") @db.Uuid
  status              String         @default("pending") @db.VarChar(50)
  rewardAmount       Decimal?       @map("reward_amount") @db.Decimal(10, 2)
  rewardGivenAt     DateTime?      @map("reward_given_at") @db.Timestamptz(6)
  orderId            String?        @map("order_id") @db.Uuid
  expiresAt          DateTime?      @map("expires_at") @db.Timestamptz(6)
  createdAt          DateTime       @map("created_at") @default(now())
  updatedAt          DateTime @map("updated_at")
  orders              Orders?        @relation(fields: [orderId], references: [id])
  profiles            Profiles?      @relation(fields: [referredProfileId], references: [id])
  referralCodes      ReferralCodes @relation(fields: [referrerCodeId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([referredEmail])
  @@index([referrerCodeId])
  @@index([status])
}

model Refunds {
  @@map("refunds")
  id                String           @id @db.Uuid
  returnRequestId String?          @map("return_request_id") @unique @db.Uuid
  orderId          String           @map("order_id") @db.Uuid
  amount            Decimal          @db.Decimal(10, 2)
  type              String           @default("full") @db.VarChar(20)
  status            RefundStatus     @default(pending)
  paymentMethod    String?          @map("payment_method") @db.VarChar(50)
  transactionId    String?          @map("transaction_id") @db.VarChar(200)
  initiatedBy      String?          @map("initiated_by") @db.Uuid
  processedAt      DateTime?        @map("processed_at") @db.Timestamptz(6)
  notes             String?
  createdAt        DateTime         @map("created_at") @default(now())
  updatedAt        DateTime @map("updated_at")
  profiles          Profiles?        @relation(fields: [initiatedBy], references: [id])
  orders            Orders           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  returnRequests   ReturnRequests? @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  @@index([initiatedBy])
  @@index([orderId])
  @@index([status])
}

model RelatedProducts {
  @@map("related_products")
  id                                            String   @id @db.Uuid
  sourceId                                     String   @map("source_id") @db.Uuid
  targetId                                     String   @map("target_id") @db.Uuid
  type                                          String   @default("related") @db.VarChar(50)
  sortOrder                                    Int      @map("sort_order") @default(0)
  createdAt                                    DateTime @map("created_at") @default(now())
  products_related_products_source_idToproducts Products @relation("related_products_source_idToproducts", fields: [sourceId], references: [id], onDelete: Cascade)
  products_related_products_target_idToproducts Products @relation("related_products_target_idToproducts", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, type])
  @@index([sourceId, type])
  @@index([targetId, type])
}

model ReturnRequests {
  @@map("return_requests")
  id               String       @id @db.Uuid
  orderId         String       @map("order_id") @db.Uuid
  orderItemId    String?      @map("order_item_id") @db.Uuid
  profileId       String       @map("profile_id") @db.Uuid
  reason           ReturnReason
  reasonDetail    String? @map("reason_detail")
  status           ReturnStatus @default(pending)
  evidenceImages  String[] @map("evidence_images")
  adminNote       String? @map("admin_note")
  reviewedBy      String?      @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime?    @map("reviewed_at") @db.Timestamptz(6)
  itemReceivedAt DateTime?    @map("item_received_at") @db.Timestamptz(6)
  createdAt       DateTime     @map("created_at") @default(now())
  updatedAt       DateTime @map("updated_at")
  refunds          Refunds?
  orders           Orders       @relation(fields: [orderId], references: [id])
  orderItems      OrderItems? @relation(fields: [orderItemId], references: [id])
  profiles         Profiles     @relation(fields: [profileId], references: [id])

  @@index([orderId])
  @@index([profileId])
  @@index([status, createdAt])
  @@index([status])
}

model Reviews {
  @@map("reviews")
  id          String   @id @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  profileId  String   @map("profile_id") @db.Uuid
  orderId    String?  @map("order_id") @db.Uuid
  rating      Int      @db.SmallInt
  title       String?  @db.VarChar(200)
  body        String?
  images      String[]
  isApproved Boolean  @map("is_approved") @default(false)
  createdAt  DateTime @map("created_at") @default(now())
  updatedAt  DateTime @map("updated_at")
  products    Products @relation(fields: [productId], references: [id])
  profiles    Profiles @relation(fields: [profileId], references: [id])

  @@unique([productId, profileId, orderId])
  @@index([productId, isApproved])
  @@index([profileId])
}

model SiteSettings {
  @@map("site_settings")
  id                      String   @id @db.Uuid
  siteName               String   @map("site_name") @db.VarChar(200)
  tagline                 String?  @db.VarChar(500)
  logoUrl                String? @map("logo_url")
  faviconUrl             String? @map("favicon_url")
  ogImageUrl            String? @map("og_image_url")
  currency                String   @default("INR") @db.VarChar(3)
  taxRate                Decimal  @map("tax_rate") @default(0) @db.Decimal(5, 2)
  freeShippingThreshold Decimal? @map("free_shipping_threshold") @db.Decimal(10, 2)
  shippingInfo           Json? @map("shipping_info")
  returnPolicy           Json? @map("return_policy")
  aboutUs                Json? @map("about_us")
  contactEmail           String?  @map("contact_email") @db.VarChar(255)
  contactPhone           String?  @map("contact_phone") @db.VarChar(20)
  address                 String?
  googleAnalyticsId     String?  @map("google_analytics_id") @db.VarChar(50)
  facebookPixelId       String?  @map("facebook_pixel_id") @db.VarChar(50)
  theme                   Json?
  createdAt              DateTime @map("created_at") @default(now())
  updatedAt              DateTime @map("updated_at")
  seo                     Json?
  preferences             Json?
  logoPublicId          String?  @map("logo_public_id") @db.VarChar(500)
  faviconPublicId       String?  @map("favicon_public_id") @db.VarChar(500)
  ogImagePublicId      String?  @map("og_image_public_id") @db.VarChar(500)
}

model SizeGuides {
  @@map("size_guides")
  id              String      @id @db.Uuid
  name            String      @db.VarChar(200)
  slug            String      @unique @db.VarChar(200)
  description     String?
  categoryId     String?     @map("category_id") @db.Uuid
  type            String      @default("clothing") @db.VarChar(50)
  unit            String      @default("inches") @db.VarChar(20)
  imageUrl       String? @map("image_url")
  measurements    Json
  isActive       Boolean     @map("is_active") @default(true)
  createdAt      DateTime    @map("created_at") @default(now())
  updatedAt      DateTime @map("updated_at")
  imagePublicId String?     @map("image_public_id") @db.VarChar(500)
  products        Products[]
  categories      Categories? @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
}

model SocialMediaLinks {
  @@map("social_media_links")
  id         String   @id @db.Uuid
  platform   String   @db.VarChar(50)
  label      String?  @db.VarChar(100)
  url        String
  icon       String?  @db.VarChar(50)
  isActive  Boolean  @map("is_active") @default(true)
  sortOrder Int      @map("sort_order") @default(0)
  createdAt DateTime @map("created_at") @default(now())
  updatedAt DateTime @map("updated_at")

  @@index([platform])
}

model StaticPages {
  @@map("static_pages")
  id           String    @id @db.Uuid
  title        String    @db.VarChar(200)
  slug         String    @unique @db.VarChar(200)
  content      Json?
  template     String    @default("default") @db.VarChar(50)
  isPublished Boolean   @map("is_published") @default(false)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  metaTitle   String?   @map("meta_title") @db.VarChar(200)
  metaDesc    String? @map("meta_desc")
  ogImage     String? @map("og_image")
  createdAt   DateTime  @map("created_at") @default(now())
  updatedAt   DateTime @map("updated_at")

  @@index([isPublished])
}

model Subcategories {
  @@map("subcategories")
  id              String     @id @db.Uuid
  name            String     @db.VarChar(200)
  slug            String     @unique @db.VarChar(200)
  description     String?
  imageUrl       String? @map("image_url")
  categoryId     String     @map("category_id") @db.Uuid
  sortOrder      Int        @map("sort_order") @default(0)
  isActive       Boolean    @map("is_active") @default(true)
  createdAt      DateTime   @map("created_at") @default(now())
  updatedAt      DateTime @map("updated_at")
  imagePublicId String?    @map("image_public_id") @db.VarChar(500)
  products        Products[]
  categories      Categories @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([isActive])
}

model SubscriptionInvoices {
  @@map("subscription_invoices")
  id                  String        @id @db.Uuid
  subscriptionId     String        @map("subscription_id") @db.Uuid
  amount              Decimal       @db.Decimal(10, 2)
  currency            String        @default("INR") @db.VarChar(3)
  status              String        @default("pending") @db.VarChar(50)
  razorpayInvoiceId String?       @map("razorpay_invoice_id") @db.VarChar(100)
  razorpayPaymentId String?       @map("razorpay_payment_id") @db.VarChar(100)
  periodStart        DateTime?     @map("period_start") @db.Timestamptz(6)
  periodEnd          DateTime?     @map("period_end") @db.Timestamptz(6)
  paidAt             DateTime?     @map("paid_at") @db.Timestamptz(6)
  createdAt          DateTime      @map("created_at") @default(now())
  updatedAt          DateTime @map("updated_at")
  subscriptions       Subscriptions @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([subscriptionId])
}

model SubscriptionPlans {
  @@map("subscription_plans")
  id                String          @id @db.Uuid
  name              String          @db.VarChar(200)
  slug              String          @unique @db.VarChar(200)
  description       String?
  price             Decimal         @db.Decimal(10, 2)
  currency          String          @default("INR") @db.VarChar(3)
  interval          String          @default("monthly") @db.VarChar(50)
  trialPeriodDays Int             @map("trial_period_days") @default(0)
  features          Json?
  isActive         Boolean         @map("is_active") @default(true)
  sortOrder        Int             @map("sort_order") @default(0)
  createdAt        DateTime        @map("created_at") @default(now())
  updatedAt        DateTime @map("updated_at")
  subscriptions     Subscriptions[]

  @@index([isActive])
  @@index([slug])
}

model Subscriptions {
  @@map("subscriptions")
  id                       String                  @id @db.Uuid
  profileId               String                  @map("profile_id") @db.Uuid
  planId                  String                  @map("plan_id") @db.Uuid
  status                   String                  @default("active") @db.VarChar(50)
  currentPeriodStart     DateTime?               @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd       DateTime?               @map("current_period_end") @db.Timestamptz(6)
  trialEndsAt            DateTime?               @map("trial_ends_at") @db.Timestamptz(6)
  cancelledAt             DateTime?               @map("cancelled_at") @db.Timestamptz(6)
  razorpaySubscriptionId String?                 @map("razorpay_subscription_id") @db.VarChar(100)
  razorpayPlanId         String?                 @map("razorpay_plan_id") @db.VarChar(100)
  paymentMethod           String?                 @map("payment_method") @db.VarChar(50)
  nextBillingAt          DateTime?               @map("next_billing_at") @db.Timestamptz(6)
  lastPaymentAt          DateTime?               @map("last_payment_at") @db.Timestamptz(6)
  createdAt               DateTime                @map("created_at") @default(now())
  updatedAt               DateTime @map("updated_at")
  subscriptionInvoices    SubscriptionInvoices[] @map("subscription_invoices")
  subscriptionPlans       SubscriptionPlans      @relation(fields: [planId], references: [id])
  profiles                 Profiles                @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, planId])
  @@index([nextBillingAt])
  @@index([status])
}

model SupportTicketReplies {
  @@map("support_ticket_replies")
  id              String          @id @db.Uuid
  ticketId       String          @map("ticket_id") @db.Uuid
  profileId      String?         @map("profile_id") @db.Uuid
  message         String
  isStaff        Boolean         @map("is_staff") @default(false)
  createdAt      DateTime        @map("created_at") @default(now())
  profiles        Profiles?       @relation(fields: [profileId], references: [id])
  supportTickets SupportTickets @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([ticketId])
}

model SupportTickets {
  @@map("support_tickets")
  id                                             String                   @id @db.Uuid
  orderId                                       String?                  @map("order_id") @db.Uuid
  profileId                                     String?                  @map("profile_id") @db.Uuid
  name                                           String                   @db.VarChar(200)
  email                                          String                   @db.VarChar(255)
  subject                                        String                   @db.VarChar(500)
  message                                        String
  status                                         SupportTicketStatus      @default(open)
  priority                                       SupportTicketPriority    @default(medium)
  assignedTo                                    String?                  @map("assigned_to") @db.Uuid
  resolvedAt                                    DateTime?                @map("resolved_at") @db.Timestamptz(6)
  createdAt                                     DateTime                 @map("created_at") @default(now())
  updatedAt                                     DateTime @map("updated_at")
  supportTicketReplies                         SupportTicketReplies[] @map("support_ticket_replies")
  profiles_support_tickets_assigned_toToprofiles Profiles?                @relation("support_tickets_assigned_toToprofiles", fields: [assignedTo], references: [id])
  orders                                         Orders?                  @relation(fields: [orderId], references: [id])
  profiles_support_tickets_profile_idToprofiles  Profiles?                @relation("support_tickets_profile_idToprofiles", fields: [profileId], references: [id])

  @@index([assignedTo])
  @@index([orderId])
  @@index([priority])
  @@index([profileId])
  @@index([status])
  @@index([status, priority])
}

model UserActionLogs {
  @@map("user_action_logs")
  id         String    @id @db.Uuid
  profileId String?   @map("profile_id") @db.Uuid
  action     String    @db.VarChar(100)
  entity     String?   @db.VarChar(100)
  entityId  String?   @map("entity_id") @db.VarChar(100)
  metadata   Json?
  ipAddress String?   @map("ip_address") @db.VarChar(45)
  userAgent String? @map("user_agent")
  createdAt DateTime  @map("created_at") @default(now())
  profiles   Profiles? @relation(fields: [profileId], references: [id])

  @@index([action, createdAt])
  @@index([entity, entityId])
  @@index([profileId])
}

model VerificationAttempts {
  @@map("verification_attempts")
  id           String    @id @db.Uuid
  profileId   String?   @map("profile_id") @db.Uuid
  email        String    @db.VarChar(255)
  code         String    @db.VarChar(10)
  ipAddress   String    @map("ip_address") @db.VarChar(45)
  success      Boolean   @default(false)
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(6)
  createdAt   DateTime  @map("created_at") @default(now())
  profiles     Profiles? @relation(fields: [profileId], references: [id])

  @@index([email, code])
  @@index([ipAddress, createdAt])
  @@index([profileId])
}

model WebhookEvents {
  @@map("webhook_events")
  id            String    @id @db.Uuid
  eventId      String    @map("event_id") @db.VarChar(200)
  source        String    @default("razorpay") @db.VarChar(50)
  eventType    String    @map("event_type") @db.VarChar(100)
  status        String    @default("received") @db.VarChar(20)
  payload       Json
  orderId      String?   @map("order_id") @db.Uuid
  errorMessage String? @map("error_message")
  processedAt  DateTime? @map("processed_at") @db.Timestamptz(6)
  retryCount   Int       @map("retry_count") @default(0)
  createdAt    DateTime  @map("created_at") @default(now())
  updatedAt    DateTime @map("updated_at")
  orders        Orders?   @relation(fields: [orderId], references: [id])

  @@unique([source, eventId])
  @@index([createdAt])
  @@index([eventType, status])
  @@index([orderId])
  @@index([status])
}

model WishlistItems {
  @@map("wishlist_items")
  id               String           @id @db.Uuid
  profileId       String           @map("profile_id") @db.Uuid
  variantId       String           @map("variant_id") @db.Uuid
  createdAt       DateTime         @map("created_at") @default(now())
  profiles         Profiles         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  productVariants ProductVariants @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([profileId, variantId])
}

