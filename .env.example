/**
 * --------------------------------------------------------------------------
 * নবME (Nabome) — Environment Variable Template
 * --------------------------------------------------------------------------
 * Copy this file to `.env` (repo root) and to each app as needed:
 *   cp .env.example .env
 *
 * Every variable below is validated at startup by `@nabome/config`
 * (see packages/config/src/env.ts). Values are placeholders only —
 * NEVER commit real secrets.
 *
 * Groups:
 *   [SHARED]      consumed by all applications
 *   [API]         consumed by apps/api (Cloudflare Pages Functions)
 *   [CUSTOMER]    consumed by apps/customer
 *   [ADMIN]       consumed by apps/admin
 *   [SHOP]        consumed by apps/shop
 * --------------------------------------------------------------------------
 */

# ──────────────────────────────────────────────────────────────────────────────
# [SHARED] Environment
# ──────────────────────────────────────────────────────────────────────────────
# development | test | production (string, required)
NODE_ENV=development
# Public origin of the application (no trailing slash)
APP_URL=http://localhost:5173
# API base URL consumed by frontends
PUBLIC_API_URL=http://localhost:8788
# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# One of: local | preview | staging | production
ENVIRONMENT=local

# ──────────────────────────────────────────────────────────────────────────────
# [SHARED] Observability
# ──────────────────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ──────────────────────────────────────────────────────────────────────────────
# [SHARED] Authentication & Security
# ──────────────────────────────────────────────────────────────────────────────
# Site-wide session cookie name (must not change after launch)
SESSION_COOKIE_NAME=nabome_session
# CSRF protection: secret used to HMAC-sign tokens
CSRF_SECRET=change-me-in-production
# JWT secret for token signing (V1 auth)
JWT_SECRET=change-me-in-production
# Cloudflare Turnstile public site key (frontends)
VITE_TURNSTILE_SITE_KEY=

# ──────────────────────────────────────────────────────────────────────────────
# [API] Database (PostgreSQL via Neon + Hyperdrive)
# ──────────────────────────────────────────────────────────────────────────────
# Local development / non-edge tooling (prisma CLI, seeds, integration tests)
DATABASE_URL=postgresql://nabome:nabome@localhost:5432/nabome?schema=public
# Cloudflare Hyperdrive connection URL (edge runtime) — replaces DATABASE_URL
HYPERDRIVE_URL=

# ──────────────────────────────────────────────────────────────────────────────
# [API] Payments (Razorpay)
# ──────────────────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ──────────────────────────────────────────────────────────────────────────────
# [API] Email (Resend)
# ──────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@nabome.online

# ──────────────────────────────────────────────────────────────────────────────
# [API] Storage (Cloudflare R2)
# ──────────────────────────────────────────────────────────────────────────────
R2_BUCKET_NAME=nabome-storage

# ──────────────────────────────────────────────────────────────────────────────
# [API] Security
# ──────────────────────────────────────────────────────────────────────────────
# Cloudflare Turnstile secret key (server-side verification)
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
# Signed webhook payloads from Nabome services
WEBHOOK_SECRET=your-webhook-secret
# Allowed CORS origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
