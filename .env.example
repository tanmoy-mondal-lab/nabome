# =============================================================================
# নবME — Required Environment Variables
# =============================================================================
# Copy this file to .env for local development.
# For production, set these as Cloudflare Pages secrets.

# ─── Frontend (Vite) — exposed to browser ───
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_RAZORPAY_KEY_ID=
VITE_SITE_URL=https://www.nabome.online
VITE_GA_ID=
VITE_CLOUDINARY_CLOUD_NAME=dmzbh87bi
VITE_CLOUDINARY_UPLOAD_PRESET=nabome_uploads
VITE_TURNSTILE_SITE_KEY=

# ─── Backend (Supabase Auth) — server-only ───
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ─── Database (Neon PostgreSQL) — server-only ───
DATABASE_URL=
DATABASE_URL_POOLED=

# ─── Razorpay — server-only ───
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Resend (Email) — server-only ───
RESEND_API_KEY=
EMAIL_FROM=hello@nabome.online
ADMIN_EMAILS=admin@nabome.online

# ─── Site URL — server-only ───
SITE_URL=https://www.nabome.online

# ─── Cloudinary — server-only ───
CLOUDINARY_CLOUD_NAME=dmzbh87bi
CLOUDINARY_UPLOAD_PRESET=nabome_uploads
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Turnstile (Bot Protection) — server-only ───
TURNSTILE_SECRET_KEY=
