# =============================================================================
# নবME — Required Environment Variables
# =============================================================================
# Copy this file to .env for local development.
# For production, set these as Cloudflare Pages secrets.

# ─── Frontend (Vite) — exposed to browser ───
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_RAZORPAY_KEY_ID=
VITE_SITE_URL=https://www.nabome.online
VITE_GA_ID=
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_TURNSTILE_SITE_KEY=

# ─── Backend (Supabase Auth) — server-only ───
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ─── Database (Neon PostgreSQL) — server-only ───
# Connection string with query timeout (10 seconds) and connection pooling
# Format: postgresql://user:pass@host:port/db?statement_timeout=10000&pool_timeout=10
# IMPORTANT: DATABASE_URL must be set as a build-time environment variable (secret)
# in the Cloudflare Pages dashboard — prisma generate needs it at build time.
DATABASE_URL=
DATABASE_URL_POOLED=

# ─── Razorpay — server-only ───
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Resend (Email) — server-only ───
RESEND_API_KEY=
EMAIL_FROM=hello@nabome.online
ADMIN_EMAILS=admin@nabome.online

# ─── Site URL — server-only ───
SITE_URL=https://www.nabome.online

# ─── Cloudinary — server-only ───
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Alert / Monitoring — server-only ───
# Webhook URL for operational alerts (e.g., Slack, Discord)
ALERT_WEBHOOK_URL=

# ─── Turnstile (Bot Protection) — server-only ───
TURNSTILE_SECRET_KEY=
